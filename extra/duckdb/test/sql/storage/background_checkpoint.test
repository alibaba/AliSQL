# name: test/sql/storage/background_checkpoint.test
# description: Test background checkpoint with enable_background_checkpoint option
# group: [storage]

# -------------------------------------------------------
# Test 1: Basic insert + auto-checkpoint + restart
# -------------------------------------------------------
load __TEST_DIR__/background_checkpoint.db

statement ok
SET enable_background_checkpoint = true

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE test (a INTEGER, b VARCHAR)

# insert enough data to trigger auto checkpoint
statement ok
INSERT INTO test SELECT i, repeat('x', 100) FROM range(1000) t(i)

query I
SELECT COUNT(*) FROM test
----
1000

# insert more to trigger another checkpoint
statement ok
INSERT INTO test SELECT i, repeat('y', 100) FROM range(1000, 2000) t(i)

query I
SELECT COUNT(*) FROM test
----
2000

# manual force checkpoint waits for background checkpoint to finish
statement ok
FORCE CHECKPOINT

query I
SELECT COUNT(*) FROM test
----
2000

# verify data survives restart
restart

query I
SELECT COUNT(*) FROM test
----
2000

query II
SELECT MIN(a), MAX(a) FROM test
----
0	1999

# -------------------------------------------------------
# Test 2: Rapid sequential inserts - many auto-checkpoints
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_rapid.db

statement ok
SET enable_background_checkpoint = true

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE rapid (a INTEGER, b VARCHAR)

# rapid inserts, each should trigger auto-checkpoint attempt
# but only one background checkpoint runs at a time (checkpoint_lock)
loop i 0 10

statement ok
INSERT INTO rapid SELECT ${i} * 1000 + j, repeat('z', 200) FROM range(1000) t(j)

endloop

query I
SELECT COUNT(*) FROM rapid
----
10000

query II
SELECT MIN(a), MAX(a) FROM rapid
----
0	9999

statement ok
FORCE CHECKPOINT

restart

query I
SELECT COUNT(*) FROM rapid
----
10000

query II
SELECT MIN(a), MAX(a) FROM rapid
----
0	9999

# -------------------------------------------------------
# Test 3: Multiple tables modified
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_multi_table.db

statement ok
SET enable_background_checkpoint = true

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE t1 (a INTEGER)

statement ok
CREATE TABLE t2 (a INTEGER)

statement ok
CREATE TABLE t3 (a VARCHAR)

statement ok
INSERT INTO t1 SELECT * FROM range(5000)

statement ok
INSERT INTO t2 SELECT * FROM range(5000, 10000)

statement ok
INSERT INTO t3 SELECT repeat('x', 100) FROM range(1000)

statement ok
FORCE CHECKPOINT

restart

query I
SELECT COUNT(*) FROM t1
----
5000

query I
SELECT COUNT(*) FROM t2
----
5000

query I
SELECT COUNT(*) FROM t3
----
1000

# -------------------------------------------------------
# Test 4: DROP TABLE after background checkpoint may have started
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_drop.db

statement ok
SET enable_background_checkpoint = true

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE to_drop (a INTEGER, b VARCHAR)

statement ok
INSERT INTO to_drop SELECT i, repeat('d', 200) FROM range(2000) t(i)

# this insert may trigger background checkpoint
statement ok
INSERT INTO to_drop SELECT i, repeat('e', 200) FROM range(2000, 4000) t(i)

statement ok
FORCE CHECKPOINT

statement ok
DROP TABLE to_drop

statement ok
CREATE TABLE survived (a INTEGER)

statement ok
INSERT INTO survived VALUES (42)

statement ok
FORCE CHECKPOINT

restart

statement error
SELECT * FROM to_drop
----
Catalog Error

query I
SELECT * FROM survived
----
42

# -------------------------------------------------------
# Test 5: Toggle option on and off
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_toggle.db

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE toggle_test (a INTEGER, b VARCHAR)

# start with background checkpoint OFF (default)
statement ok
INSERT INTO toggle_test SELECT i, repeat('a', 100) FROM range(1000) t(i)

# turn ON
statement ok
SET enable_background_checkpoint = true

statement ok
INSERT INTO toggle_test SELECT i, repeat('b', 100) FROM range(1000, 2000) t(i)

# turn OFF
statement ok
SET enable_background_checkpoint = false

statement ok
INSERT INTO toggle_test SELECT i, repeat('c', 100) FROM range(2000, 3000) t(i)

statement ok
FORCE CHECKPOINT

restart

query I
SELECT COUNT(*) FROM toggle_test
----
3000

query II
SELECT MIN(a), MAX(a) FROM toggle_test
----
0	2999

# -------------------------------------------------------
# Test 6: WAL replay correctness - restart without explicit checkpoint
# The WAL should contain all committed data even if background
# checkpoint hasn't finished yet
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_wal_replay.db

statement ok
SET enable_background_checkpoint = true

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE wal_test (a INTEGER, b VARCHAR)

statement ok
INSERT INTO wal_test SELECT i, repeat('w', 100) FROM range(500) t(i)

statement ok
INSERT INTO wal_test SELECT i, repeat('x', 100) FROM range(500, 1000) t(i)

statement ok
INSERT INTO wal_test SELECT i, repeat('y', 100) FROM range(1000, 1500) t(i)

# restart without checkpoint on shutdown - forces WAL replay
restart

query I
SELECT COUNT(*) FROM wal_test
----
1500

query II
SELECT MIN(a), MAX(a) FROM wal_test
----
0	1499

# -------------------------------------------------------
# Test 7: UPDATE and DELETE with background checkpoint
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_update_delete.db

statement ok
SET enable_background_checkpoint = true

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE ud_test (a INTEGER PRIMARY KEY, b VARCHAR)

statement ok
INSERT INTO ud_test SELECT i, repeat('o', 100) FROM range(2000) t(i)

statement ok
FORCE CHECKPOINT

# update a range of rows
statement ok
UPDATE ud_test SET b = repeat('u', 100) WHERE a >= 500 AND a < 1000

# delete a range of rows
statement ok
DELETE FROM ud_test WHERE a >= 1500

statement ok
FORCE CHECKPOINT

restart

query I
SELECT COUNT(*) FROM ud_test
----
1500

query I
SELECT COUNT(*) FROM ud_test WHERE b = repeat('u', 100)
----
500

query I
SELECT COUNT(*) FROM ud_test WHERE b = repeat('o', 100)
----
1000

query II
SELECT MIN(a), MAX(a) FROM ud_test
----
0	1499

# -------------------------------------------------------
# Test 8: Index with background checkpoint
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_index.db

statement ok
SET enable_background_checkpoint = true

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE idx_test (a INTEGER, b VARCHAR)

statement ok
CREATE INDEX idx_a ON idx_test(a)

statement ok
INSERT INTO idx_test SELECT i, repeat('i', 100) FROM range(2000) t(i)

statement ok
FORCE CHECKPOINT

restart

query I
SELECT COUNT(*) FROM idx_test WHERE a = 999
----
1

query I
SELECT COUNT(*) FROM idx_test
----
2000

# -------------------------------------------------------
# Test 9: Transaction rollback should not trigger background checkpoint
# -------------------------------------------------------
load __TEST_DIR__/bg_ckpt_rollback.db

statement ok
SET enable_background_checkpoint = true

statement ok
SET checkpoint_threshold='10KB'

statement ok
CREATE TABLE rb_test (a INTEGER)

statement ok
INSERT INTO rb_test SELECT * FROM range(1000)

statement ok
BEGIN

statement ok
INSERT INTO rb_test SELECT * FROM range(1000, 5000)

statement ok
ROLLBACK

statement ok
FORCE CHECKPOINT

restart

query I
SELECT COUNT(*) FROM rb_test
----
1000
