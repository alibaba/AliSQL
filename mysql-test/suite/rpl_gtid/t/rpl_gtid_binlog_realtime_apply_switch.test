# ==== Purpose ====
# This test case is to test the situation where realtime apply is not enabled.
#

--source include/master-slave.inc
CALL mtr.add_suppression("Binlog realtime replica failed because: .*");
--source include/rpl_sync.inc

--echo
--echo #
--echo # 1. Can't enable realtime apply when PRIVILEGE_CHECKS_USER is not NULL
--echo #######################################################################
--echo #
connection slave;
--source include/stop_slave.inc
CREATE USER 'replication_applier'@'localhost';
GRANT REPLICATION_APPLIER,SESSION_VARIABLES_ADMIN on *.* to 'replication_applier'@'localhost';
CHANGE REPLICATION SOURCE TO PRIVILEGE_CHECKS_USER = 'replication_applier'@'localhost';
--source include/start_slave.inc
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_count = 1
--let $assert_select = .* \[ERROR\] \[MY-[0-9]+] \[Repl\] Binlog realtime replica failed because: Can't enable realtime apply because PRIVILEGE_CHECKS_USER is not NULL
--let $assert_text = Can't enable realtime apply when PRIVILEGE_CHECKS_USER is not NULL
--source include/assert_grep.inc

--echo
--echo #
--echo # 2. Can't enable realtime apply when ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS is not OFF
--echo #######################################################################################
--echo #
--source include/stop_slave.inc
CHANGE REPLICATION SOURCE TO PRIVILEGE_CHECKS_USER = NULL, ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS= LOCAL, SOURCE_AUTO_POSITION=0;
--source include/start_slave.inc
--let $assert_count = 1
--let $assert_select = .* \[ERROR\] \[MY-[0-9]+] \[Repl\] Binlog realtime replica failed because: Can't enable realtime apply because ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS is not OFF
--let $assert_text = Can't enable realtime apply when ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS is not OFF
--source include/assert_grep.inc

--echo
--echo #
--echo # 3. Can't enable realtime apply when REQUIRE_TABLE_PRIMARY_KEY_CHECK is not STREAM
--echo ###################################################################################
--echo #
--source include/stop_slave.inc
CHANGE REPLICATION SOURCE TO ASSIGN_GTIDS_TO_ANONYMOUS_TRANSACTIONS= OFF, SOURCE_AUTO_POSITION=1, REQUIRE_TABLE_PRIMARY_KEY_CHECK=ON;
--source include/start_slave.inc
--let $assert_count = 1
--let $assert_select = .* \[ERROR\] \[MY-[0-9]+] \[Repl\] Binlog realtime replica failed because: Can't enable realtime apply because REQUIRE_TABLE_PRIMARY_KEY_CHECK is not STREAM
--let $assert_text = Can't enable realtime apply when REQUIRE_TABLE_PRIMARY_KEY_CHECK is not STREAM
--source include/assert_grep.inc

--echo
--echo #
--echo # 4. Can't enable realtime apply when filter is set
--echo ###################################################
--echo #
--source include/stop_slave.inc
CHANGE REPLICATION SOURCE TO REQUIRE_ROW_FORMAT=0;
CHANGE REPLICATION FILTER REPLICATE_WILD_DO_TABLE = ('db1.old%');
--source include/start_slave.inc
--let $assert_count = 1
--let $assert_select = .* \[ERROR\] \[MY-[0-9]+] \[Repl\] Binlog realtime replica failed because: Can't enable realtime apply because filter is set
--let $assert_text = Can't enable realtime apply when filter is set
--source include/assert_grep.inc

--echo
--echo #
--echo # 5. Can't enable realtime apply when it's not default channel
--echo ##############################################################
--echo #
--source include/stop_slave.inc
CHANGE REPLICATION FILTER REPLICATE_WILD_DO_TABLE = ();
--let $rpl_reset_slave_all= 1
--source include/rpl_reset_slave.inc

--disable_warnings
--replace_result $MASTER_MYPORT MASTER_PORT
--eval CHANGE MASTER TO MASTER_HOST='127.0.0.1', MASTER_PORT=$MASTER_MYPORT, MASTER_USER='root', MASTER_AUTO_POSITION= 1 FOR CHANNEL 'C1'

--let $rpl_channel_name= 'c1'
--source include/start_slave.inc

--let $assert_count = 1
--let $assert_select = .* \[ERROR\] \[MY-[0-9]+] \[Repl\] Binlog realtime replica failed because: Can't enable realtime apply because it's not default channel
--let $assert_text = Can't enable realtime apply when it's not default channel
--source include/assert_grep.inc

--source include/stop_slave.inc
--let $rpl_reset_slave_all= 1
--source include/rpl_reset_slave.inc
--replace_result $MASTER_MYPORT MASTER_PORT
--eval CHANGE MASTER TO MASTER_HOST='127.0.0.1', MASTER_PORT=$MASTER_MYPORT, MASTER_USER='root', MASTER_AUTO_POSITION= 1
--enable_warnings
 
--let $rpl_channel_name= ''
--source include/start_slave.inc

--echo
--echo #
--echo # 6. Can't enable realtime apply because replica_preserve_commit_order is on
--echo ############################################################################
--echo #
--source include/stop_slave.inc
SET GLOBAL replica_preserve_commit_order=ON;
--source include/start_slave.inc

--let $assert_count = 1
--let $assert_select = .* \[ERROR\] \[MY-[0-9]+] \[Repl\] Binlog realtime replica failed because: Can't enable realtime apply because replica_preserve_commit_order is on
--let $assert_text = Can't enable realtime apply when it's not default channel
--source include/assert_grep.inc

--echo
--echo #
--echo # 7. Clean up
--echo #############
--echo #
--source include/stop_slave.inc
SET GLOBAL replica_preserve_commit_order=OFF;
DROP USER 'replication_applier'@'localhost';
--source include/start_slave.inc
--source include/rpl_sync.inc
--source include/rpl_end.inc
