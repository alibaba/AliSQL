--force-restart
--binlog_cache_free_flush=ON
--binlog_realtime_transmit_source_enabled=ON
--binlog_realtime_ddl_time_limit=100000
--binlog_realtime_apply_ddl_source_enabled=ON
--debug-sync-timeout=1000
--binlog_realtime_replica_long_transaction_limit_size=10485760
--binlog_realtime_transmit_max_send_size=10000000
--optimize_table_write_binlog_advance=ON
--binlog_realtime_enable_log_message=ON
