include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Repl\\] Brr Worker failed executing transaction .*");
CALL mtr.add_suppression(".*The replica coordinator and worker threads are stopped.*");

#
# 0. Prepare data.
########################################################
#
SET GLOBAL debug='+d,ignore_brr_ddl_time_limit';
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
include/rpl_sync.inc

#
# 1. Test stop slave io_thread will not kill the brr worker thread when it is idle.
###################################################################################
#
# stop slave io_thread will cause the brr worker thread exit. 
include/stop_slave_io.inc
include/assert.inc [replica_brr_worker_size should be 4]
include/start_slave_io.inc

#
# 2. Test stop slave io_thread will not kill the brr worker thread when it is running.
######################################################################################
#
SET GLOBAL DEBUG = '+d,brr_worker_wait_clean_up';
SET SESSION DEBUG = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id_1 INT, ALGORITHM=INPLACE;;

## The brr worker will rollback the DDL when stop slave io_thread.
include/wait_for_pattern_in_file.inc [wait_for_gtid_event, brr index: 1 start waiting]
include/stop_slave_io.inc
## Wait before clean up so, brr cache is not removed.
include/assert.inc [replica_brr_cache_count should be 1]
RL_rds_relay_log_cache_1_1

## The brr worker will be suspend when stop slave io_thread.
include/assert.inc [replica_brr_worker_size should be 4]

## When IO thread start again, new brr cache will be create.
include/start_slave_io.inc
include/assert.inc [replica_brr_worker_size should be 4]

## New brr cache file is created.
RL_rds_relay_log_cache_1_1
RL_rds_relay_log_cache_2_1

## New brr cache will be assigned to brr worker, and it will finish apply it.
SET DEBUG_SYNC = 'now SIGNAL brr_worker_continue';
SET GLOBAL DEBUG = '-d,brr_worker_wait_clean_up';
SET DEBUG_SYNC = 'now SIGNAL continue';
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id_1` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

## Both old and new brr cache will be cleaned up.
include/assert.inc [replica_brr_cache_count should be 0]
0

#
# 3. Test stop slave io_thread will kill the brr worker thread when it is running but not execute brr event.
############################################################################################################
#
SET GLOBAL DEBUG = '+d,brr_worker_stop_before_apply_event';
SET SESSION DEBUG = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id_2 INT, ALGORITHM=INPLACE;

## Wait for new brr worker get brr cache.

## Wait set_gtid_next finished.
SET DEBUG_SYNC = 'now SIGNAL continue';
SET SESSION DEBUG = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id_3 INT, ALGORITHM=INPLACE;
SET DEBUG_SYNC = 'now SIGNAL continue';

## Stop IO thread.
include/stop_slave_io.inc

## Signal brr worker continue.
SET DEBUG_SYNC = 'now SIGNAL brr_worker_continue';
SET GLOBAL DEBUG = '-d,brr_worker_wait_clean_up';

## Start IO thread.
include/start_slave_io.inc

## The replica can be synchronized with the master.
include/rpl_sync.inc

#
# 4. If the server exits abnormally, the remaining brr cache files will be cleared after restart.
#################################################################################################
#
SET SESSION DEBUG = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id_4 INT, ALGORITHM=INPLACE;

## Brr cache file is created.
1

## Shutdown and restart server.
# Kill and restart:--skip_replica_start=ON
include/rpl_reconnect.inc

## The remaining brr cache files is cleared after restart
0
include/start_slave.inc
include/wait_for_slave_to_start.inc

#
# 5. Clean up.
########################################################
#
SET DEBUG_SYNC = 'now SIGNAL continue';
SET GLOBAL debug='-d,ignore_brr_ddl_time_limit';
DROP DATABASE rpl_test;
include/rpl_sync.inc
include/rpl_end.inc
