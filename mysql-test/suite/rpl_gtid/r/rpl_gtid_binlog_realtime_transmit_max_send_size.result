[connection master]
SHOW STATUS LIKE "source_brr%";
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
SHOW STATUS LIKE "source_sent_brr_events_count";
Variable_name	Value
source_sent_brr_events_count	10
include/assert_grep.inc [Send brr event failed, event length is too long]
# Wait for source_brr_reader_count, expect 0
#
# 2. Test send brr trx one by one if the total size of brr event in one loop exceed the max_send_size.
########################################################
#
[connection master]
# Expect source_sent_brr_events_count is 10 (now brr support asynchronous replication, so there are two FDE event, cause we start asynchronous replication, then start semi-sync replication after call  install_semisync.inc)
SHOW STATUS LIKE 'source_sent_brr_events_count';
Variable_name	Value
source_sent_brr_events_count	10
# Stop the dump thread before update brr_reader_list, to make sure 2 trxs append into brr_reader_list together.
SET GLOBAL binlog_realtime_transmit_max_send_size=10000000;
SET GLOBAL debug = '+d,wait_before_update_brr_reader_list';
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
# Continue read and send brr event, check max_size logic use source_brr_exceed_max_send_size_count later.
SET GLOBAL debug = '-d,wait_before_update_brr_reader_list';
SET debug_sync='now SIGNAL continue_update_brr_reader_list';
# Wait for source_brr_exceed_max_send_size_count, expect 4
# Wait for source_brr_reader_count, expect 2
COMMIT;
COMMIT;
# Wait for source_brr_reader_count, expect 0
SHOW STATUS LIKE "source_%";
Variable_name	Value
source_brr_exceed_max_send_size_count	4
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
source_sent_brr_events_count	26
[connection slave]
