[connection server_1]
SHOW STATUS LIKE "source_%";
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	3
source_brr_trx_count	0
source_sent_brr_events_count	27
#
# 2. Test multi replica, some of them use binlog realtime transmit, others not.
########################################################
#
# Disable binlog realtime transmit on slave 4.
[connection server_4]
STOP SLAVE;
Warnings:
Warning	1287	'STOP SLAVE' is deprecated and will be removed in a future release. Please use STOP REPLICA instead
SET GLOBAL binlog_realtime_transmit_replica_enabled = 0;
START SLAVE;
Warnings:
Warning	1287	'START SLAVE' is deprecated and will be removed in a future release. Please use START REPLICA instead
[connection server_1]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
# Wait for replica_brr_cache_count on slave 2 and 3.
[connection server_2]
include/show_relaylog_events.inc
