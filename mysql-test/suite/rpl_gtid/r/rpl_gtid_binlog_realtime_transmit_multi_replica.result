#
# 0. Prepare data.
########################################################
#
[connection server_1]
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
#
# 1. Test multi replica use binlog realtime transmit.
########################################################
#
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
# Wait for replica_brr_cache_count in all slave.
[connection server_2]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_0_1
[connection server_3]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_0_1
[connection server_4]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_0_1
# Commit the transaction on master.
[connection server_1]
SHOW STATUS LIKE "source_%";
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	3
source_brr_sender_count	3
source_brr_trx_count	1
source_sent_brr_events_count	21
COMMIT;
# Test data and relay log on slave.
[connection server_2]
include/show_relaylog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
slave-relay-bin.000003	#	Previous_gtids	#	#	Gtid_set
slave-relay-bin.000003	#	Format_desc	#	#	SERVER_VERSION, BINLOG_VERSION
slave-relay-bin.000003	#	Ignorable	#	#	# Unrecognized ignorable event
slave-relay-bin.000003	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
slave-relay-bin.000003	#	Query	#	#	BEGIN
slave-relay-bin.000003	#	Table_map	#	#	table_id: # (rpl_test.t2)
slave-relay-bin.000003	#	Write_rows	#	#	table_id: #
slave-relay-bin.000003	#	Write_rows	#	#	table_id: #
slave-relay-bin.000003	#	Write_rows	#	#	table_id: #
slave-relay-bin.000003	#	Write_rows	#	#	table_id: # flags: STMT_END_F
slave-relay-bin.000003	#	Xid	#	#	COMMIT /* XID */
slave-relay-bin.000003	#	Rotate	#	#	slave-relay-bin.000004;pos=POS
[connection server_3]
include/show_relaylog_events.inc
