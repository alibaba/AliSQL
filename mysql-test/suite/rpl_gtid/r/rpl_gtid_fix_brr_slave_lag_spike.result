#
# 0. Prepare data.
########################################################
#
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
#
# 1. Ignorable_log_event when field is used to set last_master_timestamp
########################################################################
#
include/rpl_sync.inc
SET GLOBAL debug = '+d,not_set_relay_flag_to_ignore_event';
INSERT INTO rpl_test.t2 SELECT s FROM rpl_test.t1;
include/rpl_sync.inc
include/assert_grep.inc [Ignorable_log_event when field is used to set last_master_timestamp.]
#
# 2. After fix Ignorable_log_event when field is not used to set last_master_timestamp
######################################################################################
#
include/rpl_sync.inc
SET GLOBAL debug = '-d,not_set_relay_flag_to_ignore_event';
INSERT INTO rpl_test.t2 SELECT s FROM rpl_test.t1;
include/rpl_sync.inc
include/assert_grep.inc [Ignorable_log_event when field is used to set last_master_timestamp.]

#
# 3. clean up 
#############
#
DROP DATABASE rpl_test;
include/rpl_sync.inc
include/rpl_end.inc
