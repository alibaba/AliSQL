include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

#
# 0. Prepare data.
##################
#
SET GLOBAL debug='+d,ignore_brr_ddl_time_limit';
CREATE DATABASE rpl_test1;
CREATE DATABASE rpl_test2;
CREATE TABLE rpl_test1.t1 (s LONGTEXT);
CREATE TABLE rpl_test2.t2 LIKE rpl_test1.t1;
INSERT INTO rpl_test2.t2 SELECT * FROM rpl_test1.t1;
include/rpl_sync.inc
flush binary logs;

#
# 1. Write binlog after recreate table succeed and brr worker can work normally.
################################################################################
#
SET SESSION DEBUG = '+d,optimize_after_recreate_succeed';
OPTIMIZE TABLE rpl_test1.t1;

## wait for recreate table and write binlog succeed and signal optimize table to continue
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000002	#	Previous_gtids	#	#	Gtid_set
master-bin.000002	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000002	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test1`.`t1` /* generated by server */

## ensure optimize is applied by brr worker
SET SESSION DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL optimize_continue WAIT_FOR go';
ALTER TABLE rpl_test1.t1 ADD COLUMN id_1 INT, ALGORITHM=INPLACE;

## ensure alter DDL is applied by brr worker

## signal alter table continue
Table	Op	Msg_type	Msg_text
rpl_test1.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test1.t1	optimize	status	OK
SET SESSION DEBUG = '-d,optimize_after_recreate_succeed';
SET SESSION DEBUG_SYNC = 'now SIGNAL go';

## ensure brr DDL applied by brr worker and optimize table applied by brr worker will not wait each other.
include/rpl_sync.inc
include/assert.inc [replica_brr_ddl_commit_by_brr_worker should be 1]

## ensure that the contents of the binlog are correct
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000002	#	Previous_gtids	#	#	Gtid_set
master-bin.000002	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000002	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test1`.`t1` /* generated by server */
master-bin.000002	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000002	#	Query	#	#	use `test`; ALTER TABLE rpl_test1.t1 ADD COLUMN id_1 INT, ALGORITHM=INPLACE
FLUSH BINARY LOGS;

#
# 2. Test that optimize multiple tables can work normally.
#########################################################
#

## optimize multiple tables succeed.
OPTIMIZE TABLE rpl_test1.t1, rpl_test2.t2;
Table	Op	Msg_type	Msg_text
rpl_test1.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test1.t1	optimize	status	OK
rpl_test2.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test2.t2	optimize	status	OK
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000003	#	Previous_gtids	#	#	Gtid_set
master-bin.000003	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000003	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test1`.`t1` /* generated by server */
master-bin.000003	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000003	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test2`.`t2` /* generated by server */
FLUSH BINARY LOGS;

## optimize multiple tables, some table succeed.
OPTIMIZE TABLE rpl_test1.t3, rpl_test2.t2;
Table	Op	Msg_type	Msg_text
rpl_test1.t3	optimize	Error	Table 'rpl_test1.t3' doesn't exist
rpl_test1.t3	optimize	status	Operation failed
rpl_test2.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test2.t2	optimize	status	OK
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000004	#	Previous_gtids	#	#	Gtid_set
master-bin.000004	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000004	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test2`.`t2` /* generated by server */

#
# 3. Test that optimize multiple tables failed when set gtid_next = 'xxxx'.
###########################################################################
#

## optimize multiple tables failed when set gtid_next = 'xxxx'.
SET gtid_next = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1';
OPTIMIZE TABLE rpl_test1.t1, rpl_test2.t2;
ERROR HY000: It is not allowed to perform optimize operations on multiple tables after setting gtid_next.
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000004	#	Previous_gtids	#	#	Gtid_set
master-bin.000004	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000004	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test2`.`t2` /* generated by server */

## optimize one table succeed when set gtid_next = 'xxxx'.
SET gtid_next = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1';
OPTIMIZE TABLE rpl_test1.t1;
Table	Op	Msg_type	Msg_text
rpl_test1.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test1.t1	optimize	status	OK
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000004	#	Previous_gtids	#	#	Gtid_set
master-bin.000004	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000004	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test2`.`t2` /* generated by server */
master-bin.000004	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
master-bin.000004	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test1`.`t1` /* generated by server */
SET GTID_NEXT = 'AUTOMATIC';

#
# 4. Cleanup.
#############
#
SET GLOBAL debug='-d,ignore_brr_ddl_time_limit';
DROP DATABASE rpl_test1;
DROP DATABASE rpl_test2;
include/rpl_sync.inc
include/rpl_end.inc
