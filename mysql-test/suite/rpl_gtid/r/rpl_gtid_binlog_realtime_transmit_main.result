[connection master]
include/install_semisync.inc
FLUSH STATUS;
[connection master]
SET GLOBAL binlog_realtime_transmit_source_enabled = ON;
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Repl\\] Brr Worker failed executing transaction .*");
#
# 0. Prepare data.
########################################################
#
[connection slave]
include/stop_slave.inc
SET GLOBAL binlog_realtime_transmit_replica_enabled = ON;
include/start_slave.inc
include/assert_grep.inc [Select brr init message in source error log.]
include/assert_grep.inc [Select brr init message in replica error log.]
[connection master]
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
#
# 1. Test realtime transmit for transaction use normal binlog flush.
########################################################
#
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
[connection slave]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_0_1
include/rpl_sync.inc
[connection master]
COMMIT;
[connection slave]
include/rpl_sync.inc
SELECT COUNT(*) FROM rpl_test.t2;
COUNT(*)
4
include/show_relaylog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
