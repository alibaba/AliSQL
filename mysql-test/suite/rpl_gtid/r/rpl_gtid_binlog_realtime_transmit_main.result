#
# 3. Test rollback realtime transmit for transaction.
########################################################
#
# 3.1 Test rollback the whole transaction.
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
[connection slave]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_1_3
include/rpl_sync.inc
[connection master]
ROLLBACK;
# Wait for source_brr_reader_count, expect 0
SHOW STATUS LIKE "source_brr%";
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
[connection slave]
# Wait for replica_brr_cache_count, expect 0
# Check tmp files in binlog cache tmp file dir.
[connection slave]
include/rpl_sync.inc
SELECT COUNT(*) FROM rpl_test.t2;
COUNT(*)
8
SHOW STATUS LIKE "replica_brr_cache_count";
Variable_name	Value
replica_brr_cache_count	0
# 3.2 Test rollback to savepoint.
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
[connection slave]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_1_4
include/rpl_sync.inc
[connection master]
SAVEPOINT identifier;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
ROLLBACK TO identifier;
[connection slave]
# Wait for replica_brr_cache_count, expect 0
# Check tmp files in binlog cache tmp file dir.
[connection master]
# Wait for source_brr_reader_count, expect 0
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
SHOW STATUS LIKE 'source_brr%';
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
COMMIT;
[connection slave]
include/rpl_sync.inc
include/show_relaylog_events.inc
