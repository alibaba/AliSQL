[connection master]
SHOW STATUS LIKE "source_brr%";
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
# Check the message in error log.
include/assert_grep.inc [Select brr trx init message in source error log.]
include/assert_grep.inc [Select brr reader init message in source error log.]
include/assert_grep.inc [Select brr trx removed message in source error log.]
include/assert_grep.inc [Select brr reader removed message in source error log.]
include/assert_grep.inc [Select brr cache open message in replica error log.]
include/assert_grep.inc [Select brr cache finished message in source error log.]
[connection slave]
include/stop_slave.inc
[connection master]
include/stop_dump_threads.inc
# Wait for source_brr_sender_count, expect 0
include/assert_grep.inc [Select brr sender finished.]
include/assert_grep.inc [Select brr IO thread finished.]
[connection slave]
include/start_slave.inc
