#
# 2. Test slave reconnect during transaction realtime transmit.
########################################################
#
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
[connection slave]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_2_3
include/rpl_sync.inc
[connection slave]
# Wait for replica_received_brr_events_count, expect 29
[connection master]
# Wait for source_brr_sender_count, expect 1.
# Kill dump thread on master to make slave IO thread reconnect.
[connection slave]
# Wait for replica_received_brr_events_count, expect 36 because current transaction re-transmit in brr dump thread.
include/start_slave.inc
Warnings:
Note	3083	Replication thread(s) for channel '' are already runnning.
