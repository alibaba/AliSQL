slave-relay-bin.000006	#	Previous_gtids	#	#	Gtid_set
slave-relay-bin.000006	#	Format_desc	#	#	SERVER_VERSION, BINLOG_VERSION
slave-relay-bin.000006	#	Ignorable	#	#	# Unrecognized ignorable event
slave-relay-bin.000006	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
slave-relay-bin.000006	#	Query	#	#	BEGIN
slave-relay-bin.000006	#	Table_map	#	#	table_id: # (rpl_test.t2)
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: # flags: STMT_END_F
slave-relay-bin.000006	#	Xid	#	#	COMMIT /* XID */
slave-relay-bin.000006	#	Rotate	#	#	slave-relay-bin.000007;pos=POS
