include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Repl\\] Brr Worker failed executing transaction .*");
CALL mtr.add_suppression(".*The replica coordinator and worker threads are stopped.*");
CALL mtr.add_suppression(".* Binlog realtime replica failed because: read_next_event, apply row log failed.");

#
# 0. Prepare data.
########################################################
#
SET GLOBAL debug='+d,ignore_brr_ddl_time_limit';
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
include/rpl_sync.inc

#
# 1. Test stop slave sql_thread will kill the brr worker thread when it is idle.
################################################################################
#
# stop slave sql_thread will cause the brr worker thread exit. 
include/stop_slave_sql.inc

# Kill worker thread will cause SQL thread to exit, so brr worker thread exit too.
# This can also simulate the normal worker failed to apply transaction too.
include/start_slave_sql.inc
SELECT PROCESSLIST_ID INTO @id FROM performance_schema.threads WHERE NAME LIKE "%replica_worker" LIMIT 1;
KILL QUERY @id;
include/wait_for_slave_sql_error.inc [errno=1756]
include/start_slave_sql.inc

#
# 2. Test stop slave sql_thread will kill the brr worker thread when it is running.
###################################################################################
#
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id_1 INT, ALGORITHM=INPLACE;;

## The brr worker will rollback the DDL and exit when stop slave sql_thread. 
include/stop_slave_sql.inc

## The brr worker will not affect IO thread
include/assert.inc [IO thread is running]

## Brr cache will be not removed, because the brr trx is not complete. 
include/assert.inc [replica_brr_cache_count should be 1]
1

## When brr worker start again, IO thread will not create new brr cache.
## FORMAT_DESCRIPTION_EVENT # BRR_DDL_BEGIN_EVENT # QUERY_LOG_EVENT
include/assert.inc [replica_received_brr_events_count should be 3]
include/start_slave_sql.inc
SET DEBUG_SYNC = 'now SIGNAL continue';

## GTID_EXECUTED_LOG_EVENT # GTID_LOG_EVENT

## Brr cache will be removed, because the brr trx is complete.
include/assert.inc [replica_brr_cache_count should be 0]
0

## Brr trx will not be assigned to other brr worker.
include/assert.inc [replica_brr_trx_assigned_to_brr_worker should be 1]
include/rpl_sync.inc

## normal worker will apply this transaction.
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id_1` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
include/assert.inc [replica_brr_ddl_commit_by_brr_worker should be 0]

#
# 3. Brr worker thread is invisible, we can't kill brr worker thread explicitly.
########################################################
#
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id_2 INT, ALGORITHM=INPLACE;;
SELECT PROCESSLIST_ID INTO @id FROM performance_schema.threads WHERE NAME LIKE "%brr_worker" AND PROCESSLIST_STATE not like "Waiting for brr transaction";
KILL QUERY @id;
KILL @id;
SET DEBUG_SYNC = 'now SIGNAL continue';

#
# 4. Clean up.
########################################################
#
SET GLOBAL debug='-d,ignore_brr_ddl_time_limit';
DROP DATABASE rpl_test;
include/rpl_sync.inc
include/rpl_end.inc
