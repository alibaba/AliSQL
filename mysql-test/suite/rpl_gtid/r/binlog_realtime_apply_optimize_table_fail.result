include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("\\[Warning\\] .*MY-\\d+.* \\[RDS Diagnose\\] .*");
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Repl\\] Brr Worker failed executing transaction .*");

#
# 0. Prepare data.
########################################################
#
[connection master]
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
CREATE TABLE rpl_test.t3 (s LONGTEXT);
include/rpl_sync.inc

#
# 1. OPTIMIZE TABLE and long trx run concurrently.
#    OPTIMIZE fails before MDL upgrade, long trx stays open.
#    Verify no binlog for failed DDL and BRR commits long trx.
#############################################################
#

## Save binlog position before OPTIMIZE TABLE.
[connection master]

## Start OPTIMIZE TABLE in background, paused during inplace alter.
SET GLOBAL debug = '+d,abort_after_inplace_alter_table';
SET DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL optimize_paused WAIT_FOR optimize_continue';
OPTIMIZE TABLE rpl_test.t2;

## Wait for OPTIMIZE TABLE to pause, then start long trx concurrently.
[connection master1]
SET DEBUG_SYNC = 'now WAIT_FOR optimize_paused';
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;

## Confirmed that brr worker gets the long trx and starts realtime apply.
[connection slave]

## Signal OPTIMIZE TABLE to continue. It fails via
## abort_after_inplace_alter_table (goto rollback, no MDL upgrade),
## so long trx keeps holding MDL_SHARED_WRITE on t2.
[connection master1]
SET DEBUG_SYNC = 'now SIGNAL optimize_continue';

## Reap OPTIMIZE TABLE (failed before MDL upgrade).
[connection master]
Table	Op	Msg_type	Msg_text
rpl_test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t2	optimize	error	Query execution was interrupted
rpl_test.t2	optimize	status	Operation failed
Warnings:
Error	1317	Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
SET GLOBAL debug = '';

## Now commit long trx. With the fix, OPTIMIZE TABLE did not write
## binlog, so no spurious GTID N exists.
[connection master1]
COMMIT;

## Confirmed that brr worker commits the long trx successfully.
[connection slave]

## Verify binlog: no OPTIMIZE TABLE event should be present.
[connection master]
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	#	Query	#	#	BEGIN
master-bin.000001	#	Table_map	#	#	table_id: # (rpl_test.t2)
master-bin.000001	#	Write_rows	#	#	table_id: #
master-bin.000001	#	Write_rows	#	#	table_id: #
master-bin.000001	#	Write_rows	#	#	table_id: # flags: STMT_END_F
master-bin.000001	#	Xid	#	#	COMMIT /* XID */
include/rpl_sync.inc

#
# 2. Multi-table OPTIMIZE: t2 fails, t3 succeeds.
#    Verify only t2's binlog is skipped, t3's binlog is written.
###############################################################
#

## Save binlog position.
[connection master]

## abort_after_inplace_alter_table clears itself after first trigger,
## so only the first table (t2) fails, the second table (t3) succeeds.
SET debug = '+d,abort_after_inplace_alter_table';
OPTIMIZE TABLE rpl_test.t2, rpl_test.t3;
Table	Op	Msg_type	Msg_text
rpl_test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t2	optimize	error	Query execution was interrupted
rpl_test.t2	optimize	status	Operation failed
rpl_test.t3	optimize	Error	Query execution was interrupted
rpl_test.t3	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t3	optimize	status	OK
SET debug = '';

## Verify binlog: only t3's OPTIMIZE TABLE event should be present.
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	#	Query	#	#	use `test`; OPTIMIZE TABLE `rpl_test`.`t3` /* generated by server */
include/rpl_sync.inc

#
# 3. Cleanup.
#############
#
[connection master]
DROP DATABASE rpl_test;
include/rpl_sync.inc
include/rpl_end.inc
