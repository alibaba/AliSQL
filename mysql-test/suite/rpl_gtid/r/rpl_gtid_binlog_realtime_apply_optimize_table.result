include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("\\[Warning\\] .*MY-\\d+.* \\[Repl\\] \\[RDS Diagnose\\] .*");
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Repl\\] Brr Worker failed executing transaction .*");
CALL mtr.add_suppression("\\[Warning\\] .*MY-\\d+.* \\[Server\\] \\[RDS Diagnose\\] optimize .*");
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Server\\] Binlog realtime replica failed because: mysql_admin_table.*");

#
# 0. Prepare data.
########################################################
#
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
include/rpl_sync.inc
#
# 1. Test optimize table not record binlog will not use brr.
##############################################################
#
OPTIMIZE NO_WRITE_TO_BINLOG TABLE rpl_test.t1;
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	status	OK
OPTIMIZE LOCAL TABLE rpl_test.t1;
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	status	OK
OPTIMIZE NO_WRITE_TO_BINLOG TABLE rpl_test.t1,rpl_test.t2;
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	status	OK
rpl_test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t2	optimize	status	OK
OPTIMIZE LOCAL TABLE rpl_test.t1,rpl_test.t2;
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	status	OK
rpl_test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t2	optimize	status	OK
#
# 2. Test optimize table can use realtime apply.
##############################################################
#
# optimize one table is ok.
SET GLOBAL debug='+d,ignore_brr_ddl_time_limit';
FLUSH RELAY LOGS;

## Let brr worker wait, so we can see normal worker is waiting for brr worker finish 
## transaction.
SET GLOBAL debug = '+d,brr_wait_inplace_alter_table';

## Wait after sending SA to simulate the long-running DDL and ensure that the DDL can 
## be applied by the brr worker.
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
OPTIMIZE TABLE rpl_test.t1;

## relay log cache temp file is created.
1
SET DEBUG_SYNC = 'now SIGNAL continue';

## Worker thread should be waiting for the transaction to be committed by brr worker
SET GLOBAL debug = '-d,brr_wait_inplace_alter_table';
SET DEBUG_SYNC = 'now SIGNAL continue';
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

## After brr transaction is committed, the brr cache will be removed, and relay log 
## will be removed.
0
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	status	OK
SET SESSION debug = '-d,brr_wait_inplace_alter_table';
# optimize multiple table is ok.
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
OPTIMIZE TABLE rpl_test.t1, rpl_test.t2;;
SET DEBUG_SYNC = 'now SIGNAL continue';
SET DEBUG_SYNC = 'now SIGNAL continue';
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	status	OK
rpl_test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t2	optimize	status	OK
SET SESSION debug = '-d,brr_wait_inplace_alter_table';
#
# 3. Failed optimize table can rolled back by the replica.
##########################################################
#
# brr worker failed execute optimize table before brr_set_gtid_var

SET SESSION debug = '+d,brr_wait_inplace_alter_table';
OPTIMIZE TABLE rpl_test.t1;

## relay log cache temp file is created.
1

## Kill the thd, so fail to execute DDL.
SELECT id INTO @id FROM information_schema.processlist WHERE INFO like '%rpl_test%' LIMIT 1;
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
KILL QUERY @id;

## relay log cache temp file is removed.
0
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	error	Query execution was interrupted
rpl_test.t1	optimize	status	Operation failed
Warnings:
Error	1317	Query execution was interrupted
SET SESSION debug = '-d,brr_wait_inplace_alter_table';
# brr worker failed execute optimize table after brr_set_gtid_var
include/rpl_sync.inc
SET GLOBAL debug = '+d,simulate_error_after_brr_set_gtid_var';
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
OPTIMIZE TABLE rpl_test.t1;;
SET DEBUG_SYNC = 'now SIGNAL continue';
Table	Op	Msg_type	Msg_text
rpl_test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
rpl_test.t1	optimize	status	OK
SET SESSION debug = '-d,brr_wait_inplace_alter_table';
SET GLOBAL debug = '-d,simulate_error_after_brr_set_gtid_var';

#
# 4. clean up 
#############
#
SET GLOBAL debug='-d,ignore_brr_ddl_time_limit';
DROP DATABASE rpl_test;
include/rpl_sync.inc
include/rpl_end.inc
