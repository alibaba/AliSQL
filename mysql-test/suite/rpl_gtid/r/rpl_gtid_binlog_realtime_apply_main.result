include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("\\[Warning\\] .*MY-\\d+.* \\[Repl\\] \\[RDS Diagnose\\] .*");
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Repl\\] Brr Worker failed executing transaction .*");

#
# 0. Prepare data.
########################################################
#
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
CREATE TEMPORARY TABLE rpl_test.t3 (s LONGTEXT);
include/rpl_sync.inc
#
# 1. Test short or instant ddl will not using real time apply.
########################################################
#
## Ensure binlog realtime apply is enabled on replica
include/assert_grep.inc [Ensure binlog realtime apply is enabled on replica.]
include/assert.inc [replica_brr_worker_size should be 4]

## Test instant DDL will not use real-time applications.
ALTER TABLE rpl_test.t1 ADD COLUMN id INT, ALGORITHM=INSTANT;
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

## Test analyze table not use real-time applications.
ANALYZE TABLE rpl_test.t1;
Table	Op	Msg_type	Msg_text
rpl_test.t1	analyze	status	OK
include/assert_grep.inc [Test analyze table not use real-time applications.]

## Test set sql_log_bin=0 will not use real-time applications.
set sql_log_bin=0;
ALTER TABLE rpl_test.t1 DROP COLUMN id, ALGORITHM=INPLACE;
set sql_log_bin=1;
include/assert_grep.inc [assert the brr_trx is not created]

## Test alter temporary table not use real-time applications.
ALTER TABLE rpl_test.t3 ADD COLUMN id int;
include/assert_grep.inc [assert the brr_trx is not created]

## Test short-duration DDL will not use real-time applications.
### Committed DDL.
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id0 INT, ALGORITHM=INPLACE;
SET DEBUG_SYNC = 'now SIGNAL continue';
SET SESSION debug = '-d,brr_wait_inplace_alter_table';
include/rpl_sync.inc
include/assert_grep.inc [Test short-duration DDL will not use real-time applications.]
### Rolled back DDL.
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id3 INT, ALGORITHM=INPLACE;
SELECT id INTO @id FROM information_schema.processlist WHERE INFO like '%rpl_test%' LIMIT 1;
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
KILL QUERY @id;
ERROR 70100: Query execution was interrupted
SET SESSION debug = '-d,brr_wait_inplace_alter_table';
include/assert_grep.inc [Test short-duration DDL will not use real-time applications.]

#
# 2. Test realtime apply for successfully submitted DDL will be applied by the replica.
########################################################
#

## Test realtime apply inplace DDL.
SET GLOBAL debug='+d,ignore_brr_ddl_time_limit';
FLUSH RELAY LOGS;

## Let brr worker wait, so we can see normal worker is waiting for brr worker finish 
## transaction.
SET GLOBAL debug = '+d,brr_wait_inplace_alter_table';

## Wait after sending SA to simulate the long-running DDL and ensure that the DDL can 
## be applied by the brr worker.
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id1 INT, ALGORITHM=INPLACE;

## relay log cache temp file is created.
1
SET DEBUG_SYNC = 'now SIGNAL continue';

## Worker thread should be waiting for the transaction to be committed by brr worker
SET GLOBAL debug = '-d,brr_wait_inplace_alter_table';
SET DEBUG_SYNC = 'now SIGNAL continue';
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id` int DEFAULT NULL,
  `id0` int DEFAULT NULL,
  `id1` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

## After brr transaction is committed, the brr cache will be removed, and relay log 
## will be removed.
0
SET SESSION debug = '-d,brr_wait_inplace_alter_table';

# Test realtime apply copy DDL.

## Let brr worker wait, so we can see normal worker is waiting for brr worker finish 
## transaction.
SET GLOBAL debug = '+d,brr_wait_copy_alter_table';

## Wait after sending SA to simulate the long-running DDL and ensure that the DDL can 
## be applied by the brr worker.
SET SESSION debug = '+d,brr_wait_copy_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id2 INT, ALGORITHM=COPY;

## relay log cache temp file is created.
1
SET DEBUG_SYNC = 'now SIGNAL continue';

## Worker thread should be waiting for the transaction to be committed by brr worker
SET GLOBAL debug = '-d,brr_wait_copy_alter_table';
SET DEBUG_SYNC = 'now SIGNAL continue';
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id` int DEFAULT NULL,
  `id0` int DEFAULT NULL,
  `id1` int DEFAULT NULL,
  `id2` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

## After brr transaction is committed, the brr cache will be removed, and relay log 
## will be removed.
0
SET SESSION debug = '-d,brr_wait_copy_alter_table';

# Check relay log file.
include/show_relaylog_events.inc

#
# 3. Test realtime transmit for the failed DDL will be rolled back by the replica.
##################################################################################
#

## Test realtime rollback inplace DDL.

SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id3 INT, ALGORITHM=INPLACE;

## relay log cache temp file is created.
1

## Kill the thd, so fail to execute DDL.
SELECT id INTO @id FROM information_schema.processlist WHERE INFO like '%rpl_test%' LIMIT 1;
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
KILL QUERY @id;

## relay log cache temp file is removed.
0
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id` int DEFAULT NULL,
  `id0` int DEFAULT NULL,
  `id1` int DEFAULT NULL,
  `id2` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ERROR 70100: Query execution was interrupted
SET SESSION debug = '-d,brr_wait_inplace_alter_table';

## Test realtime rollback copy DDL.

SET SESSION debug = '+d,brr_wait_copy_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id4 INT, ALGORITHM=COPY;

## relay log cache temp file is created.
1

## Kill the thd, so fail to execute DDL.
SELECT id INTO @id FROM information_schema.processlist WHERE INFO like '%rpl_test%' LIMIT 1;
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
KILL QUERY @id;

## relay log cache temp file is removed.
0
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id` int DEFAULT NULL,
  `id0` int DEFAULT NULL,
  `id1` int DEFAULT NULL,
  `id2` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ERROR 70100: Query execution was interrupted
SET SESSION debug = '-d,brr_wait_copy_alter_table';

#
# 4. Test that the brr worker failed apply DDL, it will not affect other thread 
#    and normal worker can apply it.
###############################################################################
#
show status like "%replica_brr_trx_not_assigned_to_brr_worker%";
Variable_name	Value
replica_brr_trx_not_assigned_to_brr_worker	0
SET GLOBAL debug = '+d,abort_inplace_alter_table';
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id5 INT, ALGORITHM=INPLACE;

## If the brr worker failed to replay the brr transaction, other brr
## worker will not get the chance to replay the brr transaction. 

## brr worker will not remove the brr cache
include/assert.inc [replica_brr_cache_count should be 1]

## Test that the brr worker failed apply DDL, it will not affect other thread.
include/assert.inc [replica_brr_worker_size should be 4]
include/assert.inc [IO thread is running]
include/assert.inc [SQL thread is running]
SET DEBUG_SYNC = 'now SIGNAL continue';
SET SESSION debug = '-d,brr_wait_copy_alter_table';
include/rpl_sync.inc
## brr cache will not removed brr cache, IO thread will receive subsequent brr events. (Brr_gtid_executed_log_even and brr Gtid_log_event)
include/assert_grep.inc [brr cache will not removed brr cache, IO thread will receive subsequent brr events.]

## normal worker can apply it.
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id` int DEFAULT NULL,
  `id0` int DEFAULT NULL,
  `id1` int DEFAULT NULL,
  `id2` int DEFAULT NULL,
  `id5` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SET GLOBAL debug = '-d,abort_inplace_alter_table';
show status like "%replica_brr_trx_not_assigned_to_brr_worker%";
Variable_name	Value
replica_brr_trx_not_assigned_to_brr_worker	0

#
# 5. clean up 
#############
#
SET GLOBAL debug='-d,ignore_brr_ddl_time_limit';
DROP DATABASE rpl_test;
include/rpl_sync.inc
include/rpl_end.inc
