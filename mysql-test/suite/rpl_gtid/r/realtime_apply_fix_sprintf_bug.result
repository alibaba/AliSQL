include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("\\[Warning\\] .*MY-\\d+.* \\[Repl\\] \\[RDS Diagnose\\] .*");
CALL mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* \\[Repl\\] Brr Worker failed executing transaction .*");

#
# 0. Prepare data.
########################################################
#
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
include/rpl_sync.inc

#
# 1. Realtime apply ddl.
########################################################
#
SET GLOBAL debug='+d,simulate_long_gtid_executed';
SET GLOBAL debug='+d,ignore_brr_ddl_time_limit';

## Let brr worker wait, so we can see normal worker is waiting for brr worker finish 
## transaction.
SET GLOBAL debug = '+d,brr_wait_inplace_alter_table';

## Wait after sending SA to simulate the long-running DDL and ensure that the DDL can 
## be applied by the brr worker.
SET SESSION debug = '+d,brr_wait_inplace_alter_table';
ALTER TABLE rpl_test.t1 ADD COLUMN id1 INT, ALGORITHM=INPLACE;

## relay log cache temp file is created.
1
SET DEBUG_SYNC = 'now SIGNAL continue';

## Worker thread should be waiting for the transaction to be committed by brr worker
SET GLOBAL debug = '-d,brr_wait_inplace_alter_table';
SET DEBUG_SYNC = 'now SIGNAL continue';
include/rpl_sync.inc
SHOW CREATE TABLE rpl_test.t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `s` longtext,
  `id1` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

## After brr transaction is committed, the brr cache will be removed, and relay log 
## will be removed.
0
SET SESSION debug = '-d,brr_wait_inplace_alter_table';
include/rpl_sync.inc
SET GLOBAL debug='-d,simulate_long_gtid_executed';

#
# 2. Check error log.
########################################################
#
include/assert_grep.inc [Test rds diagnose log record big transaction.]

#
# 3. Cleanup.
########################################################
#
SET GLOBAL debug='-d,ignore_brr_ddl_time_limit';
DROP DATABASE rpl_test;
include/rpl_sync.inc
include/rpl_end.inc
