[connection master]
include/install_semisync.inc
call mtr.add_suppression("Read brr event from binlog cache tmp file failed");
call mtr.add_suppression("Read rest of brr event from binlog cache tmp file failed");
call mtr.add_suppression("Timeout waiting for reply of binlog");
FLUSH STATUS;
[connection slave]
FLUSH STATUS;
[connection master]
SET GLOBAL binlog_realtime_transmit_source_enabled = ON;
#
# 0. Prepare data.
########################################################
#
[connection slave]
include/stop_slave.inc
SET GLOBAL binlog_realtime_transmit_replica_enabled = ON;
include/start_slave.inc
[connection master]
CREATE DATABASE rpl_test;
CREATE TABLE rpl_test.t1 (s LONGTEXT);
CREATE TABLE rpl_test.t2 (s LONGTEXT);
#
# 1. Test rollback transaction in send_brr_events() before real send.
########################################################
#
# 1.1 Test read brr event error will rollback the brr transaction.
# 1.1.1 Test rollback before any brr events sent to slave.
[connection master]
SET GLOBAL debug = '+d,send_brr_events_wait_before_read';
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
# Wait for source_brr_reader_count, expect 1
SHOW STATUS LIKE 'source_brr%';
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	1
source_brr_sender_count	1
source_brr_trx_count	1
[connection slave]
SHOW STATUS LIKE 'replica_brr_cache_count';
Variable_name	Value
replica_brr_cache_count	0
[connection master]
ROLLBACK;
SET debug_sync='now SIGNAL continue_before_read_brr_event';
# Wait for source_brr_trx_count, expect 0
SHOW STATUS LIKE 'source_brr%';
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
[connection slave]
# Wait for replica_brr_cache_count, expect 0
# Check tmp files in binlog cache tmp file dir.
[connection master]
SET GLOBAL debug = '-d,send_brr_events_wait_before_read';
include/assert_grep.inc [Read brr event fail, rollback this brr_trx.]
# 1.1.2 Test rollback after some brr events sent to slave.
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
[connection slave]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_0_2
include/rpl_sync.inc
[connection master]
SET GLOBAL debug = '+d,send_brr_events_wait_before_read';
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
ROLLBACK;
SET debug_sync='now SIGNAL continue_before_read_brr_event';
# Wait for source_brr_trx_count, expect 0
SHOW STATUS LIKE 'source_brr%';
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
[connection slave]
# Wait for replica_brr_cache_count, expect 0
# Check tmp files in binlog cache tmp file dir.
[connection master]
SET GLOBAL debug = '-d,send_brr_events_wait_before_read';
include/assert_grep.inc [Read brr event fail, rollback this brr_trx.]
# 1.2 Test read brr event ok but condition of brr transaction is rollback.
[connection master]
SET GLOBAL debug = '+d,send_brr_events_wait_before_read';
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
SAVEPOINT identifier;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
SHOW STATUS LIKE 'source_brr%';
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	1
source_brr_sender_count	1
source_brr_trx_count	1
[connection slave]
SHOW STATUS LIKE 'replica_brr_cache_count';
Variable_name	Value
replica_brr_cache_count	0
[connection master]
ROLLBACK TO identifier;
SET debug_sync='now SIGNAL continue_before_read_brr_event';
# Wait for source_brr_trx_count, expect 0
SHOW STATUS LIKE 'source_brr%';
Variable_name	Value
source_brr_exceed_max_send_size_count	0
source_brr_reader_count	0
source_brr_sender_count	1
source_brr_trx_count	0
[connection slave]
# Wait for replica_brr_cache_count, expect 0
# Check tmp files in binlog cache tmp file dir.
[connection master]
SET GLOBAL debug = '-d,send_brr_events_wait_before_read';
#
# 2. Test read rest brr event error during find_and_finish_brr_transaction
#     slave will reconnect and the transaction will be transmit normally again.
########################################################
#
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
[connection slave]
# Wait for replica_brr_cache_count, expect 1
# Check tmp files in binlog cache tmp file dir.
RL_rds_relay_log_cache_0_4
include/rpl_sync.inc
[connection master]
SET GLOBAL debug = '+d,send_brr_events_wait_before_read';
SET GLOBAL debug = "+d,simulate_read_rest_brr_event_error";
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
COMMIT;
SET debug_sync='now SIGNAL continue_before_read_brr_event';
# Wait for source_brr_trx_count, expect 0
[connection slave]
# Wait for replica_brr_cache_count, expect 0
# Check tmp files in binlog cache tmp file dir.
[connection slave]
include/rpl_sync.inc
include/assert_grep.inc [The dump thread should interrupt and slave reconnect.]
# The transaction should be transmit normally without ignorable event.
include/show_relaylog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
slave-relay-bin.000005	#	Previous_gtids	#	#	Gtid_set
slave-relay-bin.000005	#	Rotate	#	#	master-bin.000001;pos=POS
slave-relay-bin.000005	#	Format_desc	#	#	SERVER_VERSION, BINLOG_VERSION
slave-relay-bin.000005	#	Rotate	#	#	master-bin.000001;pos=POS
slave-relay-bin.000005	#	Rotate	#	#	master-bin.000001;pos=POS
slave-relay-bin.000005	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
slave-relay-bin.000005	#	Query	#	#	BEGIN
slave-relay-bin.000005	#	Table_map	#	#	table_id: # (rpl_test.t2)
slave-relay-bin.000005	#	Write_rows	#	#	table_id: #
slave-relay-bin.000005	#	Write_rows	#	#	table_id: #
slave-relay-bin.000005	#	Write_rows	#	#	table_id: #
slave-relay-bin.000005	#	Write_rows	#	#	table_id: # flags: STMT_END_F
slave-relay-bin.000005	#	Table_map	#	#	table_id: # (rpl_test.t2)
slave-relay-bin.000005	#	Write_rows	#	#	table_id: #
slave-relay-bin.000005	#	Write_rows	#	#	table_id: #
slave-relay-bin.000005	#	Write_rows	#	#	table_id: #
slave-relay-bin.000005	#	Write_rows	#	#	table_id: # flags: STMT_END_F
slave-relay-bin.000005	#	Xid	#	#	COMMIT /* XID */
[connection master]
SET GLOBAL debug = '-d,send_brr_events_wait_before_read';
SET GLOBAL debug = "-d,simulate_read_rest_brr_event_error";
include/assert_grep.inc [Read rest of brr event fail, rollback this brr_trx.]
#
# 3. Test realtime transmit after transaction commit and binlog cache reset.
########################################################
#
[connection master]
BEGIN;
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
# Wait for source_brr_trx_count, expect 1
SET GLOBAL debug = '+d,send_brr_events_wait_before_loop';
INSERT INTO rpl_test.t2 SELECT * FROM rpl_test.t1;
COMMIT;
# Test current session can executed transaction normally
# before last transaction finished realtime transmit.
INSERT INTO rpl_test.t2 VALUES('abc');
# Continue realtime transmit.
SET GLOBAL debug = '-d,send_brr_events_wait_before_loop';
SET debug_sync='now SIGNAL continue_brr_before_loop';
[connection slave]
include/rpl_sync.inc
# The transaction should be transmit realtimely with ignorable event.
include/show_relaylog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
slave-relay-bin.000006	#	Previous_gtids	#	#	Gtid_set
slave-relay-bin.000006	#	Format_desc	#	#	SERVER_VERSION, BINLOG_VERSION
slave-relay-bin.000006	#	Ignorable	#	#	# Unrecognized ignorable event
slave-relay-bin.000006	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
slave-relay-bin.000006	#	Query	#	#	BEGIN
slave-relay-bin.000006	#	Table_map	#	#	table_id: # (rpl_test.t2)
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: # flags: STMT_END_F
slave-relay-bin.000006	#	Table_map	#	#	table_id: # (rpl_test.t2)
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: #
slave-relay-bin.000006	#	Write_rows	#	#	table_id: # flags: STMT_END_F
slave-relay-bin.000006	#	Xid	#	#	COMMIT /* XID */
slave-relay-bin.000006	#	Rotate	#	#	slave-relay-bin.000007;pos=POS
#
# 4. Test slave will not enable realtime transmit if rds release date check fail.
########################################################
#
[connection slave]
SET GLOBAL DEBUG= "+d,simulate_slave_check_rds_brr_version_error";
include/rpl_stop_slaves.inc
include/rpl_start_slaves.inc
SHOW STATUS LIKE "replica_brr_io_thread_count";
Variable_name	Value
replica_brr_io_thread_count	0
SET GLOBAL DEBUG= "-d,simulate_slave_check_rds_brr_version_error";
#
# 5. cleanup.
########################################################
#
[connection master]
SHOW STATUS LIKE "source_sent_brr_events_count";
Variable_name	Value
source_sent_brr_events_count	29
SET GLOBAL binlog_realtime_transmit_source_enabled = DEFAULT;
DROP DATABASE rpl_test;
[connection slave]
SET GLOBAL binlog_realtime_transmit_replica_enabled = DEFAULT;
include/rpl_sync.inc
SHOW STATUS LIKE "replica_received_brr_events_count";
Variable_name	Value
replica_received_brr_events_count	29
include/uninstall_semisync.inc
include/rpl_end.inc
