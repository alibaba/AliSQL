#
# Multiple statement transaction crashs after binlogged and
# DuckDB engine is committed.
#
BEGIN;
UPDATE t1 SET c2 = "test commit" WHERE c1 = 3;
DELETE FROM t1 WHERE c1 >= 4;
SET debug = "d,crash_after_duckdb_commit";
COMMIT;
