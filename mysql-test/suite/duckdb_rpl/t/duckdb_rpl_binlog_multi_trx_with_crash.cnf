!include ../rpl_1slave_base.cnf
!include include/default_client.cnf

[mysqld]
duckdb_mode=ON

[mysqld.1]
log-bin
binlog-format = row
gtid-mode=on
enforce-gtid-consistency
character_set_server=utf8

[mysqld.2]
log-bin
binlog-format = mixed
gtid-mode=on
enforce-gtid-consistency
log-slave-updates
duckdb_multi_trx_in_batch=on
character_set_server=utf8

[mysqld.3]
log-bin
binlog-format = mixed
gtid-mode=on
enforce-gtid-consistency
log-slave-updates
duckdb_multi_trx_in_batch=on
character_set_server=utf8

[ENV]
SERVER_MYPORT_3=		@mysqld.3.port
SERVER_MYSOCK_3=		@mysqld.3.socket
