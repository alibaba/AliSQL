#
# 13) Concurrent insert across partitions yields contiguous counter
#     (auto_increment_increment / offset interplay with partitioned table)
#
CREATE TABLE t_range (
id INT NOT NULL AUTO_INCREMENT,
sale_year INT NOT NULL,
PRIMARY KEY (id, sale_year)
) ENGINE = DuckDB
PARTITION BY RANGE (sale_year) (
PARTITION p0 VALUES LESS THAN (2000),
PARTITION p1 VALUES LESS THAN (2010),
PARTITION p2 VALUES LESS THAN (2020)
);
SET @@SESSION.AUTO_INCREMENT_INCREMENT = 5;
SET @@SESSION.AUTO_INCREMENT_OFFSET = 2;
INSERT INTO t_range(sale_year) VALUES (1995), (2005), (2015), (1996), (2006);
SELECT * FROM t_range ORDER BY id;
id	sale_year
2	1995
7	2005
12	2015
17	1996
22	2006
SHOW CREATE TABLE t_range;
Table	Create Table
t_range	CREATE TABLE `t_range` (
  `id` int NOT NULL AUTO_INCREMENT,
  `sale_year` int NOT NULL,
  PRIMARY KEY (`id`,`sale_year`)
) ENGINE=DUCKDB AUTO_INCREMENT=23 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (`sale_year`)
(PARTITION p0 VALUES LESS THAN (2000) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (2010) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (2020) ENGINE = DUCKDB) */
SET @@SESSION.AUTO_INCREMENT_INCREMENT = default;
SET @@SESSION.AUTO_INCREMENT_OFFSET = default;
DROP TABLE t_range;
#
# 14) AUTO_INCREMENT column IS the partition key: PARTITION BY RANGE(id)
#
# KNOWN BUG: DuckDB native partitioning does NOT enforce RANGE partition
# bounds at INSERT time (the underlying DuckDB table is non-partitioned).
# id values outside any partition definition are silently accepted.
# Compare with InnoDB which would reject with ER_NO_PARTITION_FOR_GIVEN_VALUE.
#
CREATE TABLE t_range_id (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY
) ENGINE = DuckDB
PARTITION BY RANGE (id) (
PARTITION p0 VALUES LESS THAN (3),
PARTITION p1 VALUES LESS THAN (6),
PARTITION p2 VALUES LESS THAN (10)
);
INSERT INTO t_range_id VALUES(), (), (), (), (), (), (), (), ();
SELECT * FROM t_range_id ORDER BY id;
id
1
2
3
4
5
6
7
8
9
SHOW CREATE TABLE t_range_id;
