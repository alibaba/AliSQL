#
# 17) PARTITION BY HASH(id) does not allow DROP/TRUNCATE PARTITION,
#     so the case-5/16 bug cannot be triggered for HASH-partitioned
#     auto_increment tables.
#
CREATE TABLE t_hash_id (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY
) ENGINE = DuckDB
PARTITION BY HASH(id) PARTITIONS 4;
INSERT INTO t_hash_id VALUES(), (), (), ();
SELECT * FROM t_hash_id ORDER BY id;
id
1
2
3
4
ALTER TABLE t_hash_id TRUNCATE PARTITION p0;
ERROR HY000: [DuckDB] TRUNCATE HASH/KEY PARTITION is not supported for this operation.
ALTER TABLE t_hash_id DROP PARTITION p0;
ERROR HY000: [DuckDB] DROP/TRUNCATE PARTITION on HASH/KEY partitions is not supported for this operation.
# full TRUNCATE TABLE still works and resets counter
TRUNCATE TABLE t_hash_id;
SHOW CREATE TABLE t_hash_id;
Table	Create Table
t_hash_id	CREATE TABLE `t_hash_id` (
  `id` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY HASH (`id`)
PARTITIONS 4 */
