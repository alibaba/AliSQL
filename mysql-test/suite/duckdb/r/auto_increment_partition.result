CREATE DATABASE IF NOT EXISTS test_auto_inc_part;
USE test_auto_inc_part;
#
# 1) RANGE PARTITION + AUTO_INCREMENT
#    Counter should be table-wide (not per-partition) and span partitions.
#
CREATE TABLE t_range (
id INT NOT NULL AUTO_INCREMENT,
sale_year INT NOT NULL,
PRIMARY KEY (id, sale_year)
) ENGINE = DuckDB
PARTITION BY RANGE (sale_year) (
PARTITION p0 VALUES LESS THAN (2000),
PARTITION p1 VALUES LESS THAN (2010),
PARTITION p2 VALUES LESS THAN (2020),
PARTITION p3 VALUES LESS THAN (2030)
);
INSERT INTO t_range(sale_year) VALUES (1995), (2005), (2015), (2025);
SELECT * FROM t_range ORDER BY id;
id	sale_year
1	1995
2	2005
3	2015
4	2025
SHOW CREATE TABLE t_range;
Table	Create Table
t_range	CREATE TABLE `t_range` (
  `id` int NOT NULL AUTO_INCREMENT,
  `sale_year` int NOT NULL,
  PRIMARY KEY (`id`,`sale_year`)
) ENGINE=DUCKDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (`sale_year`)
(PARTITION p0 VALUES LESS THAN (2000) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (2010) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (2020) ENGINE = DUCKDB,
 PARTITION p3 VALUES LESS THAN (2030) ENGINE = DUCKDB) */
# explicit value > current counter must bump counter
INSERT INTO t_range VALUES (100, 1996), (200, 2025);
SELECT * FROM t_range ORDER BY id;
id	sale_year
1	1995
2	2005
3	2015
4	2025
100	1996
200	2025
SHOW CREATE TABLE t_range;
Table	Create Table
t_range	CREATE TABLE `t_range` (
  `id` int NOT NULL AUTO_INCREMENT,
  `sale_year` int NOT NULL,
  PRIMARY KEY (`id`,`sale_year`)
) ENGINE=DUCKDB AUTO_INCREMENT=201 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (`sale_year`)
(PARTITION p0 VALUES LESS THAN (2000) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (2010) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (2020) ENGINE = DUCKDB,
 PARTITION p3 VALUES LESS THAN (2030) ENGINE = DUCKDB) */
# next NULL allocation should be 201
INSERT INTO t_range(sale_year) VALUES (2005);
SELECT * FROM t_range ORDER BY id;
id	sale_year
1	1995
2	2005
3	2015
4	2025
100	1996
200	2025
201	2005
SHOW CREATE TABLE t_range;
Table	Create Table
t_range	CREATE TABLE `t_range` (
  `id` int NOT NULL AUTO_INCREMENT,
  `sale_year` int NOT NULL,
  PRIMARY KEY (`id`,`sale_year`)
) ENGINE=DUCKDB AUTO_INCREMENT=202 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (`sale_year`)
(PARTITION p0 VALUES LESS THAN (2000) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (2010) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (2020) ENGINE = DUCKDB,
 PARTITION p3 VALUES LESS THAN (2030) ENGINE = DUCKDB) */
DROP TABLE t_range;
#
# 2) LIST PARTITION + AUTO_INCREMENT
#
CREATE TABLE t_list (
id INT NOT NULL AUTO_INCREMENT,
region INT NOT NULL,
PRIMARY KEY (id, region)
) ENGINE = DuckDB
PARTITION BY LIST (region) (
PARTITION p_east VALUES IN (1, 2, 3),
PARTITION p_west VALUES IN (4, 5, 6)
);
INSERT INTO t_list(region) VALUES (1), (4), (2), (5), (3), (6);
SELECT * FROM t_list ORDER BY id;
id	region
1	1
2	4
3	2
4	5
5	3
6	6
SHOW CREATE TABLE t_list;
Table	Create Table
t_list	CREATE TABLE `t_list` (
  `id` int NOT NULL AUTO_INCREMENT,
  `region` int NOT NULL,
  PRIMARY KEY (`id`,`region`)
) ENGINE=DUCKDB AUTO_INCREMENT=7 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY LIST (`region`)
(PARTITION p_east VALUES IN (1,2,3) ENGINE = DUCKDB,
 PARTITION p_west VALUES IN (4,5,6) ENGINE = DUCKDB) */
DROP TABLE t_list;
#
# 3) KEY PARTITION + AUTO_INCREMENT
#
CREATE TABLE t_key (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY
) ENGINE = DuckDB
PARTITION BY KEY(id) PARTITIONS 4;
INSERT INTO t_key VALUES(), (), (), (), (), (), (), ();
SELECT * FROM t_key ORDER BY id;
id
1
2
3
4
5
6
7
8
SHOW CREATE TABLE t_key;
Table	Create Table
t_key	CREATE TABLE `t_key` (
  `id` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB AUTO_INCREMENT=9 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY KEY (id)
PARTITIONS 4 */
DROP TABLE t_key;
#
# 4) RANGE COLUMNS PARTITION + AUTO_INCREMENT
#
CREATE TABLE t_range_cols (
id INT NOT NULL AUTO_INCREMENT,
a INT NOT NULL,
b INT NOT NULL,
PRIMARY KEY (id, a, b)
) ENGINE = DuckDB
PARTITION BY RANGE COLUMNS (a, b) (
PARTITION p0 VALUES LESS THAN (1, 10),
PARTITION p1 VALUES LESS THAN (10, 100),
PARTITION p2 VALUES LESS THAN (100, MAXVALUE)
);
INSERT INTO t_range_cols(a, b) VALUES (0, 5), (5, 50), (50, 500);
SELECT * FROM t_range_cols ORDER BY id;
id	a	b
1	0	5
2	5	50
3	50	500
SHOW CREATE TABLE t_range_cols;
Table	Create Table
t_range_cols	CREATE TABLE `t_range_cols` (
  `id` int NOT NULL AUTO_INCREMENT,
  `a` int NOT NULL,
  `b` int NOT NULL,
  PRIMARY KEY (`id`,`a`,`b`)
) ENGINE=DUCKDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50500 PARTITION BY RANGE  COLUMNS(a,b)
(PARTITION p0 VALUES LESS THAN (1,10) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (10,100) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (100,MAXVALUE) ENGINE = DUCKDB) */
DROP TABLE t_range_cols;
#
# 5) KNOWN BUG: AUTO_INCREMENT counter regresses after TRUNCATE PARTITION
#    Expected (matches InnoDB monotonic semantics): counter stays at 4.
#    Actual: TRUNCATE PARTITION triggers Duckdb_share rebuild; get_share()
#    re-derives counter from SELECT MAX(id) (=2) -> 3, losing peak 4.
#    DROP PARTITION (case 6) does NOT have this issue because it goes
#    through inplace alter and preserves the share.
#
CREATE TABLE t_range (
id INT NOT NULL AUTO_INCREMENT,
sale_year INT NOT NULL,
PRIMARY KEY (id, sale_year)
) ENGINE = DuckDB
PARTITION BY RANGE (sale_year) (
PARTITION p0 VALUES LESS THAN (2000),
PARTITION p1 VALUES LESS THAN (2010),
PARTITION p2 VALUES LESS THAN (2020)
);
INSERT INTO t_range(sale_year) VALUES (1995), (2005), (2015);
SELECT * FROM t_range ORDER BY id;
id	sale_year
1	1995
2	2005
3	2015
SHOW CREATE TABLE t_range;
Table	Create Table
t_range	CREATE TABLE `t_range` (
  `id` int NOT NULL AUTO_INCREMENT,
  `sale_year` int NOT NULL,
  PRIMARY KEY (`id`,`sale_year`)
) ENGINE=DUCKDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (`sale_year`)
(PARTITION p0 VALUES LESS THAN (2000) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (2010) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (2020) ENGINE = DUCKDB) */
ALTER TABLE t_range TRUNCATE PARTITION p2;
SELECT * FROM t_range ORDER BY id;
id	sale_year
1	1995
2	2005
# KNOWN BUG: AUTO_INCREMENT below should be 4, not 3
SHOW CREATE TABLE t_range;
Table	Create Table
t_range	CREATE TABLE `t_range` (
  `id` int NOT NULL AUTO_INCREMENT,
  `sale_year` int NOT NULL,
  PRIMARY KEY (`id`,`sale_year`)
) ENGINE=DUCKDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (`sale_year`)
(PARTITION p0 VALUES LESS THAN (2000) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (2010) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (2020) ENGINE = DUCKDB) */
# KNOWN BUG: next allocation reuses id=3 (the deleted row's id)
INSERT INTO t_range(sale_year) VALUES (2015);
SELECT * FROM t_range ORDER BY id;
id	sale_year
1	1995
2	2005
3	2015
SHOW CREATE TABLE t_range;
Table	Create Table
t_range	CREATE TABLE `t_range` (
  `id` int NOT NULL AUTO_INCREMENT,
  `sale_year` int NOT NULL,
  PRIMARY KEY (`id`,`sale_year`)
) ENGINE=DUCKDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (`sale_year`)
(PARTITION p0 VALUES LESS THAN (2000) ENGINE = DUCKDB,
 PARTITION p1 VALUES LESS THAN (2010) ENGINE = DUCKDB,
 PARTITION p2 VALUES LESS THAN (2020) ENGINE = DUCKDB) */
DROP TABLE t_range;
