MODIFY COLUMN c_decimal DECIMAL(12,2) NOT NULL,
MODIFY COLUMN c_varchar VARCHAR(100) NOT NULL,
MODIFY COLUMN c_char CHAR(10) NOT NULL,
MODIFY COLUMN c_text TEXT NOT NULL,
MODIFY COLUMN c_tinytext TINYTEXT NOT NULL,
MODIFY COLUMN c_mediumtext MEDIUMTEXT NOT NULL,
MODIFY COLUMN c_longtext LONGTEXT NOT NULL,
MODIFY COLUMN c_blob BLOB NOT NULL,
MODIFY COLUMN c_tinyblob TINYBLOB NOT NULL,
MODIFY COLUMN c_mediumblob MEDIUMBLOB NOT NULL,
MODIFY COLUMN c_longblob LONGBLOB NOT NULL,
MODIFY COLUMN c_varbinary VARBINARY(100) NOT NULL,
MODIFY COLUMN c_time TIME NOT NULL,
