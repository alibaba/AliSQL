SET @saved_sql_mode = @@session.sql_mode;
SET SESSION sql_mode = '';
#
# 1) Type matrix — MODIFY nullable -> NOT NULL on table with NULL rows
#
CREATE TABLE t_innodb (
id INT PRIMARY KEY,
c_int INT,
c_bigint BIGINT,
c_tinyint TINYINT,
c_bool BOOL,
c_smallint SMALLINT,
c_mediumint MEDIUMINT,
c_float FLOAT,
c_double DOUBLE,
c_decimal DECIMAL(12,2),
c_varchar VARCHAR(100),
c_char CHAR(10),
c_text TEXT,
c_tinytext TINYTEXT,
c_mediumtext MEDIUMTEXT,
c_longtext LONGTEXT,
c_blob BLOB,
c_tinyblob TINYBLOB,
c_mediumblob MEDIUMBLOB,
c_longblob LONGBLOB,
c_varbinary VARBINARY(100),
c_time TIME,
c_time6 TIME(6),
c_json JSON,
c_bit BIT(8),
c_bit64 BIT(64),
c_set SET('x','y','z'),
c_enum ENUM('a','b','c')
) ENGINE=InnoDB;
CREATE TABLE t_duckdb (
id INT PRIMARY KEY,
c_int INT,
c_bigint BIGINT,
c_tinyint TINYINT,
c_bool BOOL,
c_smallint SMALLINT,
c_mediumint MEDIUMINT,
c_float FLOAT,
c_double DOUBLE,
c_decimal DECIMAL(12,2),
c_varchar VARCHAR(100),
c_char CHAR(10),
c_text TEXT,
c_tinytext TINYTEXT,
c_mediumtext MEDIUMTEXT,
c_longtext LONGTEXT,
c_blob BLOB,
c_tinyblob TINYBLOB,
c_mediumblob MEDIUMBLOB,
c_longblob LONGBLOB,
c_varbinary VARBINARY(100),
c_time TIME,
c_time6 TIME(6),
c_json JSON,
c_bit BIT(8),
c_bit64 BIT(64),
c_set SET('x','y','z'),
c_enum ENUM('a','b','c')
) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (1, NULL, NULL,NULL,NULL,NULL,NULL, NULL,NULL,NULL, NULL,NULL, NULL,NULL,NULL,NULL, NULL,NULL,NULL,NULL,NULL, NULL,NULL, NULL, NULL,NULL, NULL, NULL);
INSERT INTO t_duckdb VALUES (1, NULL, NULL,NULL,NULL,NULL,NULL, NULL,NULL,NULL, NULL,NULL, NULL,NULL,NULL,NULL, NULL,NULL,NULL,NULL,NULL, NULL,NULL, NULL, NULL,NULL, NULL, NULL);
