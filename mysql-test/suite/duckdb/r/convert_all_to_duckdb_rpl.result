include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection master]
#
# 1) CREATE INNODB TABLE IN MASTER, THE TABLE IN SLAVE WILL BE CONVERTED TO DUCKDB
#
[connection master]
CREATE TABLE t1 (id INT, name VARCHAR(255), PRIMARY KEY (id)) ENGINE = InnoDB;
INSERT INTO t1 VALUES (1, 'one');
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int(11) NOT NULL,
  `name` varchar(255) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8
SELECT * FROM t1;
id	name
1	one
include/rpl_sync.inc
[connection slave]
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int(11) NOT NULL,
  `name` varchar(255) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8
SELECT * FROM t1;
id	name
1	one
#
# 2) CREATE INNODB TABLE WITHOUT PK IN MASTER, SLAVE FALLBACK TO INNODB, IF force_innodb_to_duckdb_fallback=ON
#
[connection slave]
SET GLOBAL force_innodb_to_duckdb_fallback=ON;
[connection master]
CREATE TABLE t2 (id INT, name VARCHAR(255)) ENGINE = InnoDB;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int(11) DEFAULT NULL,
  `name` varchar(255) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8
SELECT * FROM t2;
id	name
include/rpl_sync.inc
[connection slave]
#
# 3) CREATE INNODB TABLE WITHOUT PK IN MASTER, SLAVE FAILS TO CONVERT TO DUCKDB IF force_innodb_to_duckdb_fallback=OFF
#
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int(11) DEFAULT NULL,
  `name` varchar(255) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8
SET GLOBAL force_innodb_to_duckdb_fallback=OFF;
[connection master]
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1';
CREATE TABLE t3 (id INT, name VARCHAR(255)) ENGINE = InnoDB;
SET GTID_NEXT = 'AUTOMATIC';
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id` int(11) DEFAULT NULL,
  `name` varchar(255) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8
SELECT * FROM t3;
id	name
[connection slave]
include/wait_for_slave_param.inc [Last_SQL_Errno]
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1';
BEGIN;
COMMIT;
SET GTID_NEXT = 'AUTOMATIC';
include/start_slave_sql.inc
include/rpl_sync.inc
SHOW CREATE TABLE t3;
ERROR 42S02: Table 'test.t3' doesn't exist
#
# 3) CLEANUP
#
[connection master]
DROP TABLE IF EXISTS t1, t2, t3;
[connection slave]
SET GLOBAL force_innodb_to_duckdb_fallback=default;
include/rpl_sync.inc
include/rpl_end.inc
