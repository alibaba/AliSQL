include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
#
# Cross-schema RENAME TABLE on a DuckDB table is redirected to the
# copy-DDL path (mysql_alter_table) on whichever side runs DuckDB.
# Verify that:
#   - data ends up in the new schema on both master and slave;
#   - master writes the ORIGINAL RENAME TABLE text to its binlog
#     (not rewritten as ALTER TABLE) so the slave SQL thread replays
#     the same statement and goes through the same redirect.
#
[connection master]
CREATE DATABASE db1;
CREATE DATABASE db2;
#
# 1) Scenario A: master InnoDB, slave DuckDB
#
[connection master]
FLUSH BINARY LOGS;
CREATE TABLE db1.t1 (a INT PRIMARY KEY) ENGINE = InnoDB;
INSERT INTO db1.t1 VALUES (1), (2), (3);
include/rpl_sync.inc
[connection slave]
ALTER TABLE db1.t1 ENGINE = DuckDB;
[connection master]
RENAME TABLE db1.t1 TO db2.t1;
include/rpl_sync.inc
Data lands in db2.t1 on both sides
include/rpl_diff.inc
Slave's db2.t1 is still DuckDB after the redirect
[connection slave]
SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'db2' AND TABLE_NAME = 't1';
ENGINE
DUCKDB
Master's db2.t1 is InnoDB (native cross-schema rename, no redirect)
[connection master]
SELECT ENGINE FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'db2' AND TABLE_NAME = 't1';
ENGINE
InnoDB
Master binlog Info column carries the original RENAME TABLE text
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
binlog.000002	#	Query	#	#	use `test`; CREATE TABLE db1.t1 (a INT PRIMARY KEY) ENGINE = InnoDB
binlog.000002	#	Query	#	#	BEGIN
binlog.000002	#	Table_map	#	#	table_id: # (db1.t1)
binlog.000002	#	Write_rows	#	#	table_id: # flags: STMT_END_F
binlog.000002	#	Xid	#	#	COMMIT /* XID */
binlog.000002	#	Query	#	#	use `test`; RENAME TABLE db1.t1 TO db2.t1
DROP TABLE db2.t1;
include/rpl_sync.inc
#
# 2) Scenario B: master DuckDB, slave DuckDB
#
[connection master]
FLUSH BINARY LOGS;
CREATE TABLE db1.t1 (a INT PRIMARY KEY) ENGINE = DuckDB;
INSERT INTO db1.t1 VALUES (10), (20), (30);
include/rpl_sync.inc
[connection master]
RENAME TABLE db1.t1 TO db2.t1;
include/rpl_sync.inc
Data lands in db2.t1 on both sides
include/rpl_diff.inc
Both sides' db2.t1 are DuckDB
include/rpl_diff.inc
Master binlog Info column carries the original RENAME TABLE text
(the mysql_alter_table redirect writes thd->query() verbatim, not a
synthesized ALTER TABLE)
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
binlog.000003	#	Query	#	#	use `test`; CREATE TABLE db1.t1 (a INT PRIMARY KEY) ENGINE = DuckDB
binlog.000003	#	Query	#	#	BEGIN
binlog.000003	#	Table_map	#	#	table_id: # (db1.t1)
binlog.000003	#	Write_rows	#	#	table_id: # flags: STMT_END_F
binlog.000003	#	Xid	#	#	COMMIT /* XID */
binlog.000003	#	Query	#	#	use `test`; RENAME TABLE db1.t1 TO db2.t1
DROP TABLE db2.t1;
include/rpl_sync.inc
#
# 3) Cleanup
#
[connection master]
DROP DATABASE db1;
DROP DATABASE db2;
include/rpl_sync.inc
include/rpl_end.inc
