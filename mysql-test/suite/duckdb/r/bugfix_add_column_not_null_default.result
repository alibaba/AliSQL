#
# 1) ADD COLUMN NOT NULL DEFAULT now() on table with many rows (main bug scenario)
#
CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=DuckDB;
SELECT COUNT(*) FROM t1;
COUNT(*)
20
SET TIMESTAMP=UNIX_TIMESTAMP('2001-01-01 00:00:00');
ALTER TABLE t1 ADD COLUMN col1 DATETIME NOT NULL DEFAULT now();
SELECT COUNT(*) FROM t1 WHERE col1 = '2001-01-01 00:00:00';
COUNT(*)
20
SELECT COUNT(*) FROM t1 WHERE col1 IS NULL;
COUNT(*)
0
INSERT INTO t1 VALUES (9999, 10, NULL);
ERROR 23000: Column 'col1' cannot be null
DROP TABLE t1;
#
# 2) ADD COLUMN NOT NULL DEFAULT with multiple function-default columns
#
CREATE TABLE t2 (id INT PRIMARY KEY) ENGINE=DuckDB;
SELECT COUNT(*) FROM t2;
COUNT(*)
10
SET TIMESTAMP=UNIX_TIMESTAMP('2002-02-02 00:00:00');
ALTER TABLE t2 ADD COLUMN a DATETIME NOT NULL DEFAULT now(),
ADD COLUMN b DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
ADD COLUMN c TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP;
SELECT COUNT(*) FROM t2 WHERE a = '2002-02-02 00:00:00';
COUNT(*)
10
SELECT COUNT(*) FROM t2 WHERE b = '2002-02-02 00:00:00';
COUNT(*)
10
SELECT COUNT(*) FROM t2 WHERE c = '2002-02-02 00:00:00';
COUNT(*)
10
INSERT INTO t2 VALUES (9999, NULL, '2002-02-02 00:00:00', '2002-02-02 00:00:00');
ERROR 23000: Column 'a' cannot be null
INSERT INTO t2 VALUES (9999, '2002-02-02 00:00:00', NULL, '2002-02-02 00:00:00');
ERROR 23000: Column 'b' cannot be null
INSERT INTO t2 VALUES (9999, '2002-02-02 00:00:00', '2002-02-02 00:00:00', NULL);
ERROR 23000: Column 'c' cannot be null
DROP TABLE t2;
#
# 3) ADD COLUMN without DEFAULT then MODIFY to NOT NULL should fail (NULLs exist)
#
CREATE TABLE t3 (id INT PRIMARY KEY, val INT) ENGINE=DuckDB;
INSERT INTO t3 VALUES (1, 10), (2, 20), (3, 30);
ALTER TABLE t3 ADD COLUMN col1 INT;
SELECT COUNT(*) FROM t3 WHERE col1 IS NULL;
COUNT(*)
3
ALTER TABLE t3 MODIFY COLUMN col1 INT NOT NULL;
ERROR HY000: [DuckDB] Execute sql failed. Constraint Error: NOT NULL constraint failed: t3.col1
DROP TABLE t3;
#
# 4) ADD COLUMN NOT NULL DEFAULT now() with different algorithms
#
CREATE TABLE t4 (id INT PRIMARY KEY, val INT) ENGINE=DuckDB;
SET TIMESTAMP=UNIX_TIMESTAMP('2003-03-03 00:00:00');
ALTER TABLE t4 ADD COLUMN a DATETIME NOT NULL DEFAULT now(), ALGORITHM=INSTANT;
SELECT COUNT(*) FROM t4 WHERE a = '2003-03-03 00:00:00';
COUNT(*)
10
ALTER TABLE t4 ADD COLUMN b DATETIME NOT NULL DEFAULT now(), ALGORITHM=INPLACE;
SELECT COUNT(*) FROM t4 WHERE b = '2003-03-03 00:00:00';
COUNT(*)
10
ALTER TABLE t4 ADD COLUMN c DATETIME NOT NULL DEFAULT now(), ALGORITHM=COPY;
SELECT COUNT(*) FROM t4 WHERE c = '2003-03-03 00:00:00';
COUNT(*)
10
INSERT INTO t4 VALUES (9999, 1, NULL, '2003-03-03', '2003-03-03');
ERROR 23000: Column 'a' cannot be null
INSERT INTO t4 VALUES (9999, 1, '2003-03-03', NULL, '2003-03-03');
ERROR 23000: Column 'b' cannot be null
INSERT INTO t4 VALUES (9999, 1, '2003-03-03', '2003-03-03', NULL);
ERROR 23000: Column 'c' cannot be null
DROP TABLE t4;
#
# 5) ADD COLUMN NOT NULL DEFAULT now() on empty table (should always succeed)
#
CREATE TABLE t5 (id INT PRIMARY KEY) ENGINE=DuckDB;
SET TIMESTAMP=UNIX_TIMESTAMP('2004-04-04 00:00:00');
ALTER TABLE t5 ADD COLUMN col1 DATETIME NOT NULL DEFAULT now();
INSERT INTO t5 VALUES (1, '2004-04-04 00:00:00');
INSERT INTO t5 VALUES (2, NULL);
ERROR 23000: Column 'col1' cannot be null
SELECT * FROM t5;
id	col1
1	2004-04-04 00:00:00
DROP TABLE t5;
#
# 6) ADD COLUMN NOT NULL DEFAULT now() combined with other ALTER operations
#
CREATE TABLE t6 (id INT PRIMARY KEY, a INT DEFAULT 1, b INT DEFAULT 2) ENGINE=DuckDB;
SET TIMESTAMP=UNIX_TIMESTAMP('2005-05-05 00:00:00');
ALTER TABLE t6 ADD COLUMN c DATETIME NOT NULL DEFAULT now(),
RENAME COLUMN a TO a_new,
ALTER COLUMN b SET DEFAULT 200;
SELECT COUNT(*) FROM t6 WHERE c = '2005-05-05 00:00:00';
COUNT(*)
10
INSERT INTO t6 (id, a_new) VALUES (9999, 1);
SELECT c, b FROM t6 WHERE id = 9999;
c	b
2005-05-05 00:00:00	200
DROP TABLE t6;
#
# 7) ADD COLUMN NOT NULL DEFAULT with large row count
#
CREATE TABLE t7 (id INT PRIMARY KEY) ENGINE=DuckDB;
SELECT COUNT(*) FROM t7;
COUNT(*)
100
SET TIMESTAMP=UNIX_TIMESTAMP('2006-06-06 00:00:00');
ALTER TABLE t7 ADD COLUMN col1 DATETIME NOT NULL DEFAULT now();
SELECT COUNT(*) FROM t7 WHERE col1 = '2006-06-06 00:00:00';
COUNT(*)
100
SELECT COUNT(*) FROM t7 WHERE col1 IS NULL;
COUNT(*)
0
DROP TABLE t7;
