#
# 1) Column name contains backtick
#
CREATE TABLE t_innodb (id INT NOT NULL PRIMARY KEY, `a``b` INT) ENGINE=InnoDB;
CREATE TABLE t_duckdb (id INT NOT NULL PRIMARY KEY, `a``b` INT) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (1, 100), (2, 200);
INSERT INTO t_duckdb VALUES (1, 100), (2, 200);
include/assert.inc [Checksum is the same with backtick column name]
DROP TABLE t_innodb, t_duckdb;
#
# 2) Table name contains backtick
#
CREATE TABLE `a``b_innodb` (id INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE `a``b_duckdb` (id INT NOT NULL PRIMARY KEY) ENGINE=DuckDB;
INSERT INTO `a``b_innodb` VALUES (1), (2);
INSERT INTO `a``b_duckdb` VALUES (1), (2);
include/assert.inc [Row count matches with backtick table name]
SELECT * FROM `a``b_innodb` ORDER BY id;
id
1
2
SELECT * FROM `a``b_duckdb` ORDER BY id;
id
1
2
DROP TABLE `a``b_innodb`, `a``b_duckdb`;
#
# 3) RENAME COLUMN target name contains embedded backticks
#
CREATE TABLE t_innodb (id INT NOT NULL PRIMARY KEY, a INT) ENGINE=InnoDB;
CREATE TABLE t_duckdb (id INT NOT NULL PRIMARY KEY, a INT) ENGINE=DuckDB;
ALTER TABLE t_innodb RENAME COLUMN a TO `b````c`;
ALTER TABLE t_duckdb RENAME COLUMN a TO `b````c`;
INSERT INTO t_innodb VALUES (1, 10);
INSERT INTO t_duckdb VALUES (1, 10);
include/assert.inc [Renamed column name matches between InnoDB and DuckDB]
CALL dbms_duckdb.query("PRAGMA table_info(test.t_duckdb)");
RESULT
cid	name	type	notnull	dflt_value	pk	
INTEGER	VARCHAR	VARCHAR	BOOLEAN	VARCHAR	BOOLEAN	
[ Rows: 2]
0	id	INTEGER	true	NULL	false
1	b``c	INTEGER	false	NULL	false


SELECT table_name, column_name, ordinal_position, column_type,
column_default, is_nullable, column_key
FROM information_schema.columns
WHERE table_schema = DATABASE()
AND table_name IN ('t_innodb', 't_duckdb')
ORDER BY table_name, ordinal_position;
TABLE_NAME	COLUMN_NAME	ORDINAL_POSITION	COLUMN_TYPE	COLUMN_DEFAULT	IS_NULLABLE	COLUMN_KEY
t_duckdb	id	1	int	NULL	NO	PRI
t_duckdb	b``c	2	int	NULL	YES	
t_innodb	id	1	int	NULL	NO	PRI
t_innodb	b``c	2	int	NULL	YES	
include/assert.inc [Checksum is the same after RENAME COLUMN with backtick]
DROP TABLE t_innodb, t_duckdb;
#
# 4) Batch DML cycle on backtick-named table and column
#
SET @saved_duckdb_dml_in_batch = @@global.duckdb_dml_in_batch;
SET @saved_duckdb_batch_max_row_count = @@global.duckdb_batch_max_row_count;
SET GLOBAL duckdb_dml_in_batch = ON;
SET GLOBAL duckdb_batch_max_row_count = 1;
CREATE TABLE `t``dml_innodb` (id INT NOT NULL PRIMARY KEY, `c``v` VARCHAR(32)) ENGINE=InnoDB;
CREATE TABLE `t``dml_duckdb` (id INT NOT NULL PRIMARY KEY, `c``v` VARCHAR(32)) ENGINE=DuckDB;
INSERT INTO `t``dml_innodb` VALUES (1, 'a'), (2, 'b'), (3, 'c');
INSERT INTO `t``dml_duckdb` VALUES (1, 'a'), (2, 'b'), (3, 'c');
UPDATE `t``dml_innodb` SET `c``v` = 'X' WHERE id = 2;
UPDATE `t``dml_duckdb` SET `c``v` = 'X' WHERE id = 2;
DELETE FROM `t``dml_innodb` WHERE id = 3;
DELETE FROM `t``dml_duckdb` WHERE id = 3;
include/assert.inc [Row count matches after INSERT/UPDATE/DELETE on backtick names]
SELECT * FROM `t``dml_innodb` ORDER BY id;
id	c`v
1	a
2	X
SELECT * FROM `t``dml_duckdb` ORDER BY id;
id	c`v
1	a
2	X
DROP TABLE `t``dml_innodb`, `t``dml_duckdb`;
SET GLOBAL duckdb_batch_max_row_count = @saved_duckdb_batch_max_row_count;
SET GLOBAL duckdb_dml_in_batch = @saved_duckdb_dml_in_batch;
#
# 5) TRUNCATE TABLE on backtick-named table.
#
CREATE TABLE `t``trunc_duckdb` (id INT NOT NULL PRIMARY KEY) ENGINE=DuckDB;
INSERT INTO `t``trunc_duckdb` VALUES (1), (2), (3);
TRUNCATE TABLE `t``trunc_duckdb`;
include/assert.inc [TRUNCATE on backtick-named DuckDB table empties the table]
DROP TABLE `t``trunc_duckdb`;
#
# 6) Text defaults containing backslash, NUL byte, and single quote.
#
CREATE TABLE t_innodb (
id INT NOT NULL PRIMARY KEY,
c VARCHAR(16) DEFAULT 'a\\b',
d VARCHAR(16) DEFAULT 'a\0b',
e VARCHAR(16) DEFAULT 'it''s'
) ENGINE=InnoDB;
CREATE TABLE t_duckdb (
id INT NOT NULL PRIMARY KEY,
c VARCHAR(16) DEFAULT 'a\\b',
d VARCHAR(16) DEFAULT 'a\0b',
e VARCHAR(16) DEFAULT 'it''s'
) ENGINE=DuckDB;
INSERT INTO t_innodb(id) VALUES (1);
INSERT INTO t_duckdb(id) VALUES (1);
include/assert.inc [Backslash text default matches between InnoDB and DuckDB]
include/assert.inc [NUL byte text default matches between InnoDB and DuckDB]
include/assert.inc [Single quote text default matches between InnoDB and DuckDB]
SELECT table_name, column_name, HEX(column_default), is_nullable
FROM information_schema.columns
WHERE table_schema = DATABASE()
AND table_name IN ('t_innodb', 't_duckdb')
AND column_name IN ('c', 'd', 'e')
ORDER BY table_name, ordinal_position;
TABLE_NAME	COLUMN_NAME	HEX(column_default)	IS_NULLABLE
t_duckdb	c	615C62	YES
t_duckdb	d	610062	YES
t_duckdb	e	69742773	YES
t_innodb	c	615C62	YES
t_innodb	d	610062	YES
t_innodb	e	69742773	YES
CALL dbms_duckdb.query("SELECT column_name, hex(column_default), length(column_default) FROM information_schema.columns WHERE table_name='t_duckdb' AND column_name IN ('c','d','e') ORDER BY ordinal_position");
RESULT
column_name	hex(column_default)	length(column_default)	
VARCHAR	VARCHAR	BIGINT	
[ Rows: 3]
c	27615C6227	5
d	2761006227	5
e	27697427277327	7


SELECT id, HEX(c), LENGTH(c), HEX(d), LENGTH(d), HEX(e), LENGTH(e)
FROM t_innodb ORDER BY id;
id	HEX(c)	LENGTH(c)	HEX(d)	LENGTH(d)	HEX(e)	LENGTH(e)
1	615C62	3	610062	3	69742773	4
SELECT id, HEX(c), LENGTH(c), HEX(d), LENGTH(d), HEX(e), LENGTH(e)
FROM t_duckdb ORDER BY id;
id	HEX(c)	LENGTH(c)	HEX(d)	LENGTH(d)	HEX(e)	LENGTH(e)
1	615C62	3	610062	3	69742773	4
DROP TABLE t_innodb, t_duckdb;
#
# 7) Direct DML on backtick-named table and columns.
#
SET @saved_duckdb_dml_in_batch = @@global.duckdb_dml_in_batch;
SET GLOBAL duckdb_dml_in_batch = OFF;
CREATE TABLE `t``direct_innodb` (
id INT NOT NULL PRIMARY KEY,
`c``v` VARCHAR(32)
) ENGINE=InnoDB;
CREATE TABLE `t``direct_duckdb` (
id INT NOT NULL PRIMARY KEY,
`c``v` VARCHAR(32)
) ENGINE=DuckDB;
INSERT INTO `t``direct_innodb` VALUES (1, 'a'), (2, 'b'), (3, 'c');
INSERT INTO `t``direct_duckdb` VALUES (1, 'a'), (2, 'b'), (3, 'c');
UPDATE `t``direct_innodb` SET `c``v` = 'Y' WHERE id = 2;
UPDATE `t``direct_duckdb` SET `c``v` = 'Y' WHERE id = 2;
DELETE FROM `t``direct_innodb` WHERE id = 3;
DELETE FROM `t``direct_duckdb` WHERE id = 3;
include/assert.inc [Direct DML row count matches on backtick names]
SELECT * FROM `t``direct_innodb` ORDER BY id;
id	c`v
1	a
2	Y
SELECT * FROM `t``direct_duckdb` ORDER BY id;
id	c`v
1	a
2	Y
DROP TABLE `t``direct_innodb`, `t``direct_duckdb`;
SET GLOBAL duckdb_dml_in_batch = @saved_duckdb_dml_in_batch;
#
# 8) TRUNCATE/DROP PARTITION on backtick-named table and column.
#
CREATE TABLE `t``part_duckdb` (
`i``d` INT NOT NULL,
v INT,
PRIMARY KEY (`i``d`)
) ENGINE=DuckDB
PARTITION BY RANGE (`i``d`) (
PARTITION p0 VALUES LESS THAN (10),
PARTITION p1 VALUES LESS THAN (20),
PARTITION pmax VALUES LESS THAN MAXVALUE
);
INSERT INTO `t``part_duckdb` VALUES (1, 10), (11, 110), (21, 210);
ALTER TABLE `t``part_duckdb` TRUNCATE PARTITION p0;
SELECT `i``d`, v FROM `t``part_duckdb` ORDER BY `i``d`;
i`d	v
11	110
21	210
ALTER TABLE `t``part_duckdb` DROP PARTITION p1;
SELECT `i``d`, v FROM `t``part_duckdb` ORDER BY `i``d`;
i`d	v
21	210
DROP TABLE `t``part_duckdb`;
#
# 9) ENUM values containing quotes, backslash, and NUL bytes
#
CREATE TABLE t_innodb (id INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t_duckdb (id INT NOT NULL PRIMARY KEY) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (1);
INSERT INTO t_duckdb VALUES (1);
ALTER TABLE t_innodb ADD COLUMN c ENUM('it''s','a\0\\b','ok') NOT NULL;
ALTER TABLE t_duckdb ADD COLUMN c ENUM('it''s','a\0\\b','ok') NOT NULL;
INSERT INTO t_innodb VALUES (2, 'a\0\\b');
INSERT INTO t_duckdb VALUES (2, 'a\0\\b');
include/assert.inc [Checksum matches after ADD COLUMN ENUM with quote, backslash, and NUL byte]
SELECT table_name, column_name, HEX(column_type), HEX(column_default),
is_nullable
FROM information_schema.columns
WHERE table_schema = DATABASE()
AND table_name IN ('t_innodb', 't_duckdb')
AND column_name = 'c'
 ORDER BY table_name;
TABLE_NAME	COLUMN_NAME	HEX(column_type)	HEX(column_default)	IS_NULLABLE
t_duckdb	c	656E756D28276974272773272C27615C305C5C62272C276F6B2729	NULL	NO
t_innodb	c	656E756D28276974272773272C27615C305C5C62272C276F6B2729	NULL	NO
CALL dbms_duckdb.query("SELECT column_name, column_default IS NULL AS no_default, data_type FROM information_schema.columns WHERE table_name='t_duckdb' AND column_name='c'");
RESULT
column_name	no_default	data_type	
VARCHAR	BOOLEAN	VARCHAR	
[ Rows: 1]
c	true	VARCHAR


SELECT id, HEX(c), LENGTH(c) FROM t_innodb ORDER BY id;
id	HEX(c)	LENGTH(c)
1	69742773	4
2	61005C62	4
SELECT id, HEX(c), LENGTH(c) FROM t_duckdb ORDER BY id;
id	HEX(c)	LENGTH(c)
1	69742773	4
2	61005C62	4
DROP TABLE t_innodb, t_duckdb;
CREATE TABLE t_innodb (id INT NOT NULL PRIMARY KEY, x INT) ENGINE=InnoDB;
CREATE TABLE t_duckdb (id INT NOT NULL PRIMARY KEY, x INT) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (1,1),(2,2),(3,3);
INSERT INTO t_duckdb VALUES (1,1),(2,2),(3,3);
ALTER TABLE t_innodb MODIFY COLUMN x ENUM('it''s','a\0b','a\\b');
ALTER TABLE t_duckdb MODIFY COLUMN x ENUM('it''s','a\0b','a\\b');
include/assert.inc [Checksum matches after MODIFY numeric->ENUM with quote, backslash, and NUL byte]
SELECT table_name, column_name, HEX(column_type), HEX(column_default),
is_nullable
FROM information_schema.columns
WHERE table_schema = DATABASE()
AND table_name IN ('t_innodb', 't_duckdb')
AND column_name = 'x'
 ORDER BY table_name;
TABLE_NAME	COLUMN_NAME	HEX(column_type)	HEX(column_default)	IS_NULLABLE
t_duckdb	x	656E756D28276974272773272C27615C3062272C27615C5C622729	NULL	YES
t_innodb	x	656E756D28276974272773272C27615C3062272C27615C5C622729	NULL	YES
CALL dbms_duckdb.query("SELECT column_name, hex(column_default), data_type FROM information_schema.columns WHERE table_name='t_duckdb' AND column_name='x'");
RESULT
column_name	hex(column_default)	data_type	
VARCHAR	VARCHAR	VARCHAR	
[ Rows: 1]
x	4E554C4C	VARCHAR


SELECT id, HEX(x), LENGTH(x) FROM t_innodb ORDER BY id;
id	HEX(x)	LENGTH(x)
1	69742773	4
2	610062	3
3	615C62	3
SELECT id, HEX(x), LENGTH(x) FROM t_duckdb ORDER BY id;
id	HEX(x)	LENGTH(x)
1	69742773	4
2	610062	3
3	615C62	3
DROP TABLE t_innodb, t_duckdb;
CREATE TABLE t_innodb (id INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t_duckdb (id INT NOT NULL PRIMARY KEY) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (1);
INSERT INTO t_duckdb VALUES (1);
ALTER TABLE t_innodb ADD COLUMN c ENUM('a\01b','ok') NOT NULL;
ALTER TABLE t_duckdb ADD COLUMN c ENUM('a\01b','ok') NOT NULL;
INSERT INTO t_innodb VALUES (2, 'a\01b');
INSERT INTO t_duckdb VALUES (2, 'a\01b');
include/assert.inc [Checksum matches after ADD COLUMN ENUM with NUL followed by digit]
SELECT id, HEX(c), LENGTH(c) FROM t_innodb ORDER BY id;
id	HEX(c)	LENGTH(c)
1	61003162	4
2	61003162	4
SELECT id, HEX(c), LENGTH(c) FROM t_duckdb ORDER BY id;
id	HEX(c)	LENGTH(c)
1	61003162	4
2	61003162	4
DROP TABLE t_innodb, t_duckdb;
#
# 10) RENAME TABLE to a name containing embedded backticks
#
CREATE TABLE `t``ren_innodb` (id INT NOT NULL PRIMARY KEY, v INT) ENGINE=InnoDB;
CREATE TABLE `t``ren_duckdb` (id INT NOT NULL PRIMARY KEY, v INT) ENGINE=DuckDB;
INSERT INTO `t``ren_innodb` VALUES (1, 10);
INSERT INTO `t``ren_duckdb` VALUES (1, 10);
ALTER TABLE `t``ren_innodb` RENAME TO `t``ren``new_innodb`;
ALTER TABLE `t``ren_duckdb` RENAME TO `t``ren``new_duckdb`;
include/assert.inc [Renamed table name shape matches between InnoDB and DuckDB]
CALL dbms_duckdb.query("SELECT count(*) FROM information_schema.tables WHERE table_name = 't`ren`new_duckdb'");
RESULT
count_star()	
BIGINT	
[ Rows: 1]
1


SELECT table_name, column_name, ordinal_position, column_type,
column_default, is_nullable, column_key
FROM information_schema.columns
WHERE table_schema = DATABASE()
AND (table_name LIKE 't%new_innodb' OR table_name LIKE 't%new_duckdb')
ORDER BY table_name, ordinal_position;
TABLE_NAME	COLUMN_NAME	ORDINAL_POSITION	COLUMN_TYPE	COLUMN_DEFAULT	IS_NULLABLE	COLUMN_KEY
t`ren`new_duckdb	id	1	int	NULL	NO	PRI
t`ren`new_duckdb	v	2	int	NULL	YES	
t`ren`new_innodb	id	1	int	NULL	NO	PRI
t`ren`new_innodb	v	2	int	NULL	YES	
INSERT INTO `t``ren``new_innodb` VALUES (2, 20);
INSERT INTO `t``ren``new_duckdb` VALUES (2, 20);
include/assert.inc [Row count matches after RENAME TABLE to backtick name]
DROP TABLE `t``ren``new_innodb`, `t``ren``new_duckdb`;
#
# 11) ENGINE switch on backtick-named table and column
#
CREATE TABLE `t``sw` (
id INT NOT NULL PRIMARY KEY,
`c``v` VARCHAR(32)
) ENGINE=InnoDB;
INSERT INTO `t``sw` VALUES (1, 'a'), (2, 'b'), (3, 'c');
SELECT column_name, ordinal_position, column_type, column_default,
is_nullable, column_key
FROM information_schema.columns
WHERE table_schema = DATABASE() AND table_name = 't`sw'
 ORDER BY ordinal_position;
COLUMN_NAME	ORDINAL_POSITION	COLUMN_TYPE	COLUMN_DEFAULT	IS_NULLABLE	COLUMN_KEY
id	1	int	NULL	NO	PRI
c`v	2	varchar(32)	NULL	YES	
ALTER TABLE `t``sw` ENGINE = DuckDB;
CALL dbms_duckdb.query("PRAGMA table_info(`test`.`t``sw`)");
RESULT
cid	name	type	notnull	dflt_value	pk	
INTEGER	VARCHAR	VARCHAR	BOOLEAN	VARCHAR	BOOLEAN	
[ Rows: 2]
0	id	INTEGER	true	NULL	false
1	c`v	VARCHAR	false	NULL	false


SELECT column_name, ordinal_position, column_type, column_default,
is_nullable, column_key
FROM information_schema.columns
WHERE table_schema = DATABASE() AND table_name = 't`sw'
 ORDER BY ordinal_position;
COLUMN_NAME	ORDINAL_POSITION	COLUMN_TYPE	COLUMN_DEFAULT	IS_NULLABLE	COLUMN_KEY
id	1	int	NULL	NO	PRI
c`v	2	varchar(32)	NULL	YES	
INSERT INTO `t``sw` VALUES (4, 'd');
UPDATE `t``sw` SET `c``v` = 'X' WHERE id = 2;
DELETE FROM `t``sw` WHERE id = 3;
SELECT * FROM `t``sw` ORDER BY id;
id	c`v
1	a
2	X
4	d
ALTER TABLE `t``sw` ENGINE = InnoDB;
SELECT column_name, ordinal_position, column_type, column_default,
is_nullable, column_key
FROM information_schema.columns
WHERE table_schema = DATABASE() AND table_name = 't`sw'
 ORDER BY ordinal_position;
COLUMN_NAME	ORDINAL_POSITION	COLUMN_TYPE	COLUMN_DEFAULT	IS_NULLABLE	COLUMN_KEY
id	1	int	NULL	NO	PRI
c`v	2	varchar(32)	NULL	YES	
SELECT * FROM `t``sw` ORDER BY id;
id	c`v
1	a
2	X
4	d
DROP TABLE `t``sw`;
#
# 12) Other ALTER COLUMN operations on backtick-named column
#
CREATE TABLE t_innodb (
id INT NOT NULL PRIMARY KEY,
`c``a` INT NOT NULL,
`c``b` INT
) ENGINE=InnoDB;
CREATE TABLE t_duckdb (
id INT NOT NULL PRIMARY KEY,
`c``a` INT NOT NULL,
`c``b` INT
) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (1, 100, 200);
INSERT INTO t_duckdb VALUES (1, 100, 200);
ALTER TABLE t_innodb MODIFY COLUMN `c``a` BIGINT NOT NULL;
ALTER TABLE t_duckdb MODIFY COLUMN `c``a` BIGINT NOT NULL;
ALTER TABLE t_innodb ALTER COLUMN `c``a` SET DEFAULT 7;
ALTER TABLE t_duckdb ALTER COLUMN `c``a` SET DEFAULT 7;
ALTER TABLE t_innodb ALTER COLUMN `c``a` DROP DEFAULT;
ALTER TABLE t_duckdb ALTER COLUMN `c``a` DROP DEFAULT;
ALTER TABLE t_innodb MODIFY COLUMN `c``a` BIGINT NULL;
ALTER TABLE t_duckdb MODIFY COLUMN `c``a` BIGINT NULL;
ALTER TABLE t_innodb DROP COLUMN `c``b`;
ALTER TABLE t_duckdb DROP COLUMN `c``b`;
INSERT INTO t_innodb VALUES (2, 999);
INSERT INTO t_duckdb VALUES (2, 999);
include/assert.inc [Checksum matches after MODIFY/SET DEFAULT/DROP DEFAULT/DROP NOT NULL/DROP COLUMN on backtick column]
CALL dbms_duckdb.query("PRAGMA table_info(test.t_duckdb)");
RESULT
cid	name	type	notnull	dflt_value	pk	
INTEGER	VARCHAR	VARCHAR	BOOLEAN	VARCHAR	BOOLEAN	
[ Rows: 2]
0	id	INTEGER	true	NULL	false
1	c`a	BIGINT	false	NULL	false


SELECT table_name, column_name, ordinal_position, column_type,
column_default, is_nullable, column_key
FROM information_schema.columns
WHERE table_schema = DATABASE()
AND table_name IN ('t_innodb', 't_duckdb')
ORDER BY table_name, ordinal_position;
TABLE_NAME	COLUMN_NAME	ORDINAL_POSITION	COLUMN_TYPE	COLUMN_DEFAULT	IS_NULLABLE	COLUMN_KEY
t_duckdb	id	1	int	NULL	NO	PRI
t_duckdb	c`a	2	bigint	NULL	YES	
t_innodb	id	1	int	NULL	NO	PRI
t_innodb	c`a	2	bigint	NULL	YES	
DROP TABLE t_innodb, t_duckdb;
