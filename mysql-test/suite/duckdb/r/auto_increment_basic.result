##################################
# TEST FOR NON-PARTITIONED TABLE #
##################################
#
# 1) INSERT AND UPDATE WILL CHANGE AUTO_INCREMENT
#
CREATE TABLE t1(id INT AUTO_INCREMENT key) ENGINE = DuckDB;
SET GLOBAL duckdb_dml_in_batch = ON;
INSERT INTO t1 VALUES(), (), ();
SELECT * FROM t1 ORDER BY id;
id
1
2
3
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
UPDATE t1 SET id = 10 WHERE id = 1;
SELECT * FROM t1 ORDER BY id;
id
2
3
10
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SET GLOBAL duckdb_dml_in_batch = OFF;
INSERT INTO t1 VALUES(), (), ();
SELECT * FROM t1 ORDER BY id;
id
2
3
10
11
12
13
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB AUTO_INCREMENT=14 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SET GLOBAL duckdb_dml_in_batch = default;
#
# 2) DDL
#
RENAME TABLE t1 TO t2;
INSERT INTO t2 VALUES(), (), ();
SELECT * FROM t2 ORDER BY id;
id
