#
# 6) variable duckdb_support_auto_increment
#
SET GLOBAL duckdb_support_auto_increment = OFF;
CREATE TABLE t1(id INT AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE = DuckDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL DEFAULT '0',
  `b` int DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CREATE TABLE t2(id INT PRIMARY KEY, b INT AUTO_INCREMENT, INDEX idx_b(b)) ENGINE = DuckDB;
Warnings:
Warning	7505	[DuckDB] Index 'idx_b' is removed.
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int NOT NULL,
  `b` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1, t2;
CREATE TABLE t1(id INT AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE = DuckDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL DEFAULT '0',
  `b` int DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 DROP PRIMARY KEY, ADD COLUMN c INT AUTO_INCREMENT, ADD PRIMARY KEY(c, id);
ERROR HY000: [DuckDB] ADD AUTO_INCREMENT COLUMN is not supported for this operation.
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL DEFAULT '0',
  `b` int DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
SET GLOBAL duckdb_support_auto_increment = ON;
CREATE TABLE t1(id INT AUTO_INCREMENT PRIMARY KEY, b INT) ENGINE = DuckDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `b` int DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CREATE TABLE t2(id INT PRIMARY KEY, b INT AUTO_INCREMENT, INDEX idx_b(b)) ENGINE = DuckDB;
ERROR 42000: Incorrect table definition; there can be only one auto column and it must be defined as a key
DROP TABLE t1;
#
# 7) ADD/CHANGE COLUMN FROM no-auto-increment TO auto-increment
#
CREATE TABLE t1(id INT PRIMARY KEY, b INT) ENGINE = DuckDB;
ALTER TABLE t1 DROP PRIMARY KEY, ADD COLUMN c INT AUTO_INCREMENT, ADD PRIMARY KEY(c, id);
ERROR HY000: [DuckDB] ADD AUTO_INCREMENT COLUMN is not supported for this operation.
INSERT INTO t1 VALUES(1, 1), (101, 2), (1001, 3), (10001, 4);
SELECT * FROM t1 ORDER BY id;
id	b
1	1
101	2
1001	3
10001	4
SET GLOBAL duckdb_support_auto_increment = ON;
ALTER TABLE t1 MODIFY COLUMN id INT AUTO_INCREMENT;
INSERT INTO t1(b) VALUES(5);
INSERT INTO t1 VALUES (100001, 6);
INSERT INTO t1(b) VALUES(7);
SELECT * FROM t1 ORDER BY id;
id	b
1	1
101	2
1001	3
10001	4
10002	5
100001	6
100002	7
DROP TABLE t1;
#
# 8) CLEANUP
#

