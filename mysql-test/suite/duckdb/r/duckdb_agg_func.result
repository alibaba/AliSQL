CREATE TABLE t_json_obj_innodb (
id INT PRIMARY KEY,
col_tinyint TINYINT,
col_int INT,
col_bigint BIGINT,
col_double DOUBLE,
col_decimal DECIMAL(38, 10),
col_time TIME,
col_date DATE,
col_datetime DATETIME,
col_timestamp TIMESTAMP,
col_varchar VARCHAR(100)
);
CREATE TABLE t_json_obj_duckdb (
id INT PRIMARY KEY,
col_tinyint TINYINT,
col_int INT,
col_bigint BIGINT,
col_double DOUBLE,
col_decimal DECIMAL(38, 10),
col_time TIME,
col_date DATE,
col_datetime DATETIME,
col_timestamp TIMESTAMP,
col_varchar VARCHAR(100)
) ENGINE=DuckDB;
