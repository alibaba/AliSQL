include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
# Prepare
[connection master]
CREATE TABLE t1 (
id BIGINT NOT NULL,
c0 DECIMAL(40, 20) NOT NULL,
PRIMARY KEY(id)
) ENGINE=InnoDB;
include/rpl_sync.inc
[connection slave]
ALTER TABLE t1 ENGINE=DuckDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint NOT NULL,
  `c0` decimal(40,20) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=DUCKDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Insert overflow DECIMAL into Master
include/stop_slave_sql.inc
[connection master]
INSERT INTO t1 VALUES(1, '123456');
INSERT INTO t1 VALUES(2, '1435323879643025700');
# Slave's replication interrupted
[connection slave]
CALL mtr.add_suppression("MY-010584");
include/start_slave_sql.inc
include/wait_for_slave_sql_to_stop.inc
# Alter Slave's table to InnoDB, resume replication
[connection slave]
ALTER TABLE t1 ENGINE=InnoDB;
include/start_slave_sql.inc
include/rpl_sync.inc
# Cleanup
[connection master]
DROP TABLE t1;
include/rpl_sync.inc
include/rpl_end.inc
