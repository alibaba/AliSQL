CREATE TABLE t_innodb (
	id INT PRIMARY KEY,
	col1 TINYINT,
	col2 INT,
	col3 BIGINT,
	col4 DOUBLE,
	col5 DECIMAL(38, 10),
	col6 TIME,
	col7 DATE,
	col8 DATETIME,
	col9 TIMESTAMP,
	col10 VARCHAR(100),
	col11 BLOB
);

CREATE TABLE t_duckdb (
	id INT PRIMARY KEY,
	col1 TINYINT,
	col2 INT,
	col3 BIGINT,
	col4 DOUBLE,
	col5 DECIMAL(38, 10),
	col6 TIME,
	col7 DATE,
	col8 DATETIME,
	col9 TIMESTAMP,
	col10 VARCHAR(100),
	col11 BLOB
) ENGINE=DuckDB;

INSERT INTO t_innodb VALUES (1, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
                            (2, 10, 123456789, 123456789011121314, 123456789011121314.12345678910, 1234567890111213141516171819.123456789, '23:59:59', '2025-12-31', '9999-12-31 23:59:59', '2025-12-31 23:59:59', '1234567890111213141516171819.123456789', '1234567890111213141516171819.123456789'),
                            (3, -10, -123456789, -123456789011121314, -123456789011121314.12345678910, -1234567890111213141516171819.123456789, '00:00:00', '1970-01-01', '0001-01-01 00:00:00', '1970-01-02 00:00:00', '-1234567890111213141516171819.123456789', '-1234567890111213141516171819.123456789'),
                            (4, -10, -123456789, -123456789011121314, -123456789011121314.12345678910, -1234567890111213141516171819.123456789, '00:00:00', '1970-01-01', '0001-01-01 00:00:00', '1970-01-02 00:00:00', REPEAT('a', 100), REPEAT('a', 65535));


INSERT INTO t_duckdb VALUES (1, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
                            (2, 10, 123456789, 123456789011121314, 123456789011121314.12345678910, 1234567890111213141516171819.123456789, '23:59:59', '2025-12-31', '9999-12-31 23:59:59', '2025-12-31 23:59:59', '1234567890111213141516171819.123456789', '1234567890111213141516171819.123456789'),
                            (3, -10, -123456789, -123456789011121314, -123456789011121314.12345678910, -1234567890111213141516171819.123456789, '00:00:00', '1970-01-01', '0001-01-01 00:00:00', '1970-01-02 00:00:00', '-1234567890111213141516171819.123456789', '-1234567890111213141516171819.123456789'),
                            (4, -10, -123456789, -123456789011121314, -123456789011121314.12345678910, -1234567890111213141516171819.123456789, '00:00:00', '1970-01-01', '0001-01-01 00:00:00', '1970-01-02 00:00:00', REPEAT('a', 100), REPEAT('a', 65535));

--echo --------------------------
--echo 1. AVG()
--echo --------------------------

SELECT AVG(col1), AVG(col2), AVG(col3), AVG(col4),
       AVG(col5), AVG(col6), AVG(col7), AVG(col8),
       AVG(col9), AVG(col10)
FROM t_innodb;

SELECT AVG(col1), AVG(col2), AVG(col3), AVG(col4),
       AVG(col5), AVG(col6), AVG(col7), AVG(col8),
       AVG(col9), AVG(col10)
FROM t_duckdb;

# AVG(Blob) is not supported yet.
--error ER_DUCKDB_CLIENT
SELECT AVG(col11)
FROM t_duckdb WHERE id <= 3;

--echo --------------------------
--echo 2. BIT_AND()
--echo --------------------------

SELECT BIT_AND(col1), BIT_AND(col2), BIT_AND(col3)
FROM t_innodb;

SELECT BIT_AND(col1), BIT_AND(col2), BIT_AND(col3)
FROM t_duckdb;

# DECIMAL, DOUBLE, TIME, DATE, TIMESTAMP, VARCHAR, BLOB is not supoorted yet.
--error ER_DUCKDB_CLIENT
SELECT BIT_AND(col4), BIT_AND(col5), BIT_AND(col6),
       BIT_AND(col7), BIT_AND(col8), BIT_AND(col9),
       BIT_AND(col10)
FROM t_duckdb;

--echo --------------------------
--echo 3. BIT_OR()
--echo --------------------------

SELECT BIT_OR(col1), BIT_OR(col2), BIT_OR(col3)
FROM t_innodb;

SELECT BIT_OR(col1), BIT_OR(col2), BIT_OR(col3)
FROM t_duckdb;

# DECIMAL, DOUBLE, TIME, DATE, TIMESTAMP, VARCHAR, BLOB is not supoorted yet.
--error ER_DUCKDB_CLIENT
SELECT BIT_OR(col4), BIT_OR(col5), BIT_OR(col6),
       BIT_OR(col7), BIT_OR(col8), BIT_OR(col9),
       BIT_OR(col10)
FROM t_duckdb;

--echo --------------------------
--echo 4. BIT_XOR()
--echo --------------------------

SELECT BIT_XOR(col1), BIT_XOR(col2), BIT_XOR(col3)
FROM t_innodb;

SELECT BIT_XOR(col1), BIT_XOR(col2), BIT_XOR(col3)
FROM t_duckdb;

# DECIMAL, DOUBLE, TIME, DATE, TIMESTAMP, VARCHAR, BLOB is not supoorted yet.
--error ER_DUCKDB_CLIENT
SELECT BIT_XOR(col4), BIT_XOR(col5), BIT_XOR(col6),
       BIT_XOR(col7), BIT_XOR(col8), BIT_XOR(col9),
       BIT_XOR(col10)
FROM t_duckdb;

--echo --------------------------
--echo 5. COUNT()
--echo --------------------------

SELECT COUNT(col1), COUNT(col2), COUNT(col3), COUNT(col4),
       COUNT(col5), COUNT(col6), COUNT(col7), COUNT(col8),
       COUNT(col9), COUNT(col10), COUNT(col11)
FROM t_innodb;

SELECT COUNT(col1), COUNT(col2), COUNT(col3), COUNT(col4),
       COUNT(col5), COUNT(col6), COUNT(col7), COUNT(col8),
       COUNT(col9), COUNT(col10), COUNT(col11)
FROM t_duckdb;

SELECT COUNT(DISTINCT col1), COUNT(DISTINCT col2), COUNT(DISTINCT col3), COUNT(DISTINCT col4),
       COUNT(DISTINCT col5), COUNT(DISTINCT col6), COUNT(DISTINCT col7), COUNT(DISTINCT col8),
       COUNT(DISTINCT col9), COUNT(DISTINCT col10), COUNT(DISTINCT col11)
FROM t_innodb;

SELECT COUNT(DISTINCT col1), COUNT(DISTINCT col2), COUNT(DISTINCT col3), COUNT(DISTINCT col4),
       COUNT(DISTINCT col5), COUNT(DISTINCT col6), COUNT(DISTINCT col7), COUNT(DISTINCT col8),
       COUNT(DISTINCT col9), COUNT(DISTINCT col10), COUNT(DISTINCT col11)
FROM t_duckdb;

--echo --------------------------
--echo 6. GROUP_CONCAT()
--echo --------------------------

SET group_concat_max_len = 100000;

SELECT GROUP_CONCAT(col1), GROUP_CONCAT(col2), GROUP_CONCAT(col3), GROUP_CONCAT(col4),
       GROUP_CONCAT(col5), GROUP_CONCAT(col6), GROUP_CONCAT(col7), GROUP_CONCAT(col8),
       GROUP_CONCAT(col9), LENGTH(GROUP_CONCAT(col10)), LENGTH(GROUP_CONCAT(col11))
FROM t_innodb;

# DuckDB is not affected by group_concat_max_len parameter
SELECT GROUP_CONCAT(col1), GROUP_CONCAT(col2), GROUP_CONCAT(col3), GROUP_CONCAT(col4),
       GROUP_CONCAT(col5), GROUP_CONCAT(col6), GROUP_CONCAT(col7), GROUP_CONCAT(col8),
       GROUP_CONCAT(col9), LENGTH(GROUP_CONCAT(col10)), LENGTH(GROUP_CONCAT(col11))
FROM t_duckdb;

--echo --------------------------
--echo 7. JSON_ARRAYAGG()
--echo --------------------------

# Not support yet

--echo --------------------------
--echo 8. JSON_OBJECTAGG()
--echo --------------------------

# Create dedicated tables for JSON_OBJECTAGG tests (need unique keys)
CREATE TABLE t_json_obj_innodb (
	id INT PRIMARY KEY,
	col_tinyint TINYINT,
	col_int INT,
	col_bigint BIGINT,
	col_double DOUBLE,
	col_decimal DECIMAL(38, 10),
	col_time TIME,
	col_date DATE,
	col_datetime DATETIME,
	col_timestamp TIMESTAMP,
	col_varchar VARCHAR(100)
);

CREATE TABLE t_json_obj_duckdb (
	id INT PRIMARY KEY,
	col_tinyint TINYINT,
	col_int INT,
	col_bigint BIGINT,
	col_double DOUBLE,
	col_decimal DECIMAL(38, 10),
	col_time TIME,
	col_date DATE,
	col_datetime DATETIME,
	col_timestamp TIMESTAMP,
	col_varchar VARCHAR(100)
) ENGINE=DuckDB;

# Insert rows with unique values suitable for keys
INSERT INTO t_json_obj_innodb VALUES
	(1, 1, 100, 1000000000, 1.11, 111.1111111111, '01:00:00', '2020-01-01', '2020-01-01 01:00:00', '2020-01-01 01:00:00', 'key_a'),
	(2, 2, 200, 2000000000, 2.22, 222.2222222222, '02:00:00', '2021-06-15', '2021-06-15 12:30:00', '2021-06-15 12:30:00', 'key_b'),
	(3, 3, 300, 3000000000, 3.33, 333.3333333333, '03:00:00', '2022-12-31', '2022-12-31 23:59:59', '2022-12-31 23:59:59', 'key_c'),
	(4, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);

INSERT INTO t_json_obj_duckdb VALUES
	(1, 1, 100, 1000000000, 1.11, 111.1111111111, '01:00:00', '2020-01-01', '2020-01-01 01:00:00', '2020-01-01 01:00:00', 'key_a'),
	(2, 2, 200, 2000000000, 2.22, 222.2222222222, '02:00:00', '2021-06-15', '2021-06-15 12:30:00', '2021-06-15 12:30:00', 'key_b'),
	(3, 3, 300, 3000000000, 3.33, 333.3333333333, '03:00:00', '2022-12-31', '2022-12-31 23:59:59', '2022-12-31 23:59:59', 'key_c'),
	(4, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);

# ----- 8.1 All data types as KEY, VARCHAR as VALUE -----

# TINYINT as key
SELECT JSON_OBJECTAGG(col_tinyint, col_varchar) FROM t_json_obj_innodb WHERE col_tinyint IS NOT NULL;
SELECT JSON_OBJECTAGG(col_tinyint, col_varchar) FROM t_json_obj_duckdb WHERE col_tinyint IS NOT NULL;

# INT as key
SELECT JSON_OBJECTAGG(col_int, col_varchar) FROM t_json_obj_innodb WHERE col_int IS NOT NULL;
SELECT JSON_OBJECTAGG(col_int, col_varchar) FROM t_json_obj_duckdb WHERE col_int IS NOT NULL;

# BIGINT as key
SELECT JSON_OBJECTAGG(col_bigint, col_varchar) FROM t_json_obj_innodb WHERE col_bigint IS NOT NULL;
SELECT JSON_OBJECTAGG(col_bigint, col_varchar) FROM t_json_obj_duckdb WHERE col_bigint IS NOT NULL;

# DOUBLE as key
SELECT JSON_OBJECTAGG(col_double, col_varchar) FROM t_json_obj_innodb WHERE col_double IS NOT NULL;
SELECT JSON_OBJECTAGG(col_double, col_varchar) FROM t_json_obj_duckdb WHERE col_double IS NOT NULL;

# DECIMAL as key
SELECT JSON_OBJECTAGG(col_decimal, col_varchar) FROM t_json_obj_innodb WHERE col_decimal IS NOT NULL;
SELECT JSON_OBJECTAGG(col_decimal, col_varchar) FROM t_json_obj_duckdb WHERE col_decimal IS NOT NULL;

# TIME as key
SELECT JSON_OBJECTAGG(col_time, col_varchar) FROM t_json_obj_innodb WHERE col_time IS NOT NULL;
SELECT JSON_OBJECTAGG(col_time, col_varchar) FROM t_json_obj_duckdb WHERE col_time IS NOT NULL;

# DATE as key
SELECT JSON_OBJECTAGG(col_date, col_varchar) FROM t_json_obj_innodb WHERE col_date IS NOT NULL;
SELECT JSON_OBJECTAGG(col_date, col_varchar) FROM t_json_obj_duckdb WHERE col_date IS NOT NULL;

# DATETIME as key
SELECT JSON_OBJECTAGG(col_datetime, col_varchar) FROM t_json_obj_innodb WHERE col_datetime IS NOT NULL;
SELECT JSON_OBJECTAGG(col_datetime, col_varchar) FROM t_json_obj_duckdb WHERE col_datetime IS NOT NULL;

# TIMESTAMP as key
SELECT JSON_OBJECTAGG(col_timestamp, col_varchar) FROM t_json_obj_innodb WHERE col_timestamp IS NOT NULL;
SELECT JSON_OBJECTAGG(col_timestamp, col_varchar) FROM t_json_obj_duckdb WHERE col_timestamp IS NOT NULL;

# VARCHAR as key
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# ----- 8.2 VARCHAR as KEY, all data types as VALUE -----

# TINYINT as value
SELECT JSON_OBJECTAGG(col_varchar, col_tinyint) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_tinyint) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# INT as value
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# BIGINT as value
SELECT JSON_OBJECTAGG(col_varchar, col_bigint) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_bigint) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# DOUBLE as value
SELECT JSON_OBJECTAGG(col_varchar, col_double) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_double) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# DECIMAL as value
SELECT JSON_OBJECTAGG(col_varchar, col_decimal) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_decimal) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# TIME as value
SELECT JSON_OBJECTAGG(col_varchar, col_time) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_time) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# DATE as value
SELECT JSON_OBJECTAGG(col_varchar, col_date) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_date) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# DATETIME as value
SELECT JSON_OBJECTAGG(col_varchar, col_datetime) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_datetime) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# TIMESTAMP as value
SELECT JSON_OBJECTAGG(col_varchar, col_timestamp) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_timestamp) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# VARCHAR as value
SELECT JSON_OBJECTAGG(col_varchar, col_varchar) FROM t_json_obj_innodb WHERE col_varchar IS NOT NULL;
SELECT JSON_OBJECTAGG(col_varchar, col_varchar) FROM t_json_obj_duckdb WHERE col_varchar IS NOT NULL;

# ----- 8.3 NULL key handling -----
# In MySQL, NULL key in JSON_OBJECTAGG should produce an error

# NULL key from TINYINT column
--error 3158
SELECT JSON_OBJECTAGG(col_tinyint, col_varchar) FROM t_json_obj_innodb;
--error ER_DUCKDB_CLIENT
SELECT JSON_OBJECTAGG(col_tinyint, col_varchar) FROM t_json_obj_duckdb;

# NULL key from INT column
--error 3158
SELECT JSON_OBJECTAGG(col_int, col_varchar) FROM t_json_obj_innodb;
--error ER_DUCKDB_CLIENT
SELECT JSON_OBJECTAGG(col_int, col_varchar) FROM t_json_obj_duckdb;

# NULL key from VARCHAR column
--error 3158
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_innodb;
--error ER_DUCKDB_CLIENT
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_duckdb;

# ----- 8.4 NULL value handling (NULL values should appear as JSON null) -----

# Create a table where key is NOT NULL but value can be NULL
CREATE TABLE t_json_obj_null_innodb (
	id INT PRIMARY KEY,
	str_key VARCHAR(20) NOT NULL,
	col_tinyint TINYINT,
	col_int INT,
	col_bigint BIGINT,
	col_double DOUBLE,
	col_decimal DECIMAL(38, 10),
	col_time TIME,
	col_date DATE,
	col_datetime DATETIME,
	col_timestamp TIMESTAMP,
	col_varchar VARCHAR(100)
);

CREATE TABLE t_json_obj_null_duckdb (
	id INT PRIMARY KEY,
	str_key VARCHAR(20) NOT NULL,
	col_tinyint TINYINT,
	col_int INT,
	col_bigint BIGINT,
	col_double DOUBLE,
	col_decimal DECIMAL(38, 10),
	col_time TIME,
	col_date DATE,
	col_datetime DATETIME,
	col_timestamp TIMESTAMP,
	col_varchar VARCHAR(100)
) ENGINE=DuckDB;

INSERT INTO t_json_obj_null_innodb VALUES
	(1, 'k1', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
	(2, 'k2', 10, 200, 3000000000, 2.22, 222.2222222222, '12:00:00', '2023-01-01', '2023-01-01 12:00:00', '2023-01-01 12:00:00', 'hello'),
	(3, 'k3', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);

INSERT INTO t_json_obj_null_duckdb VALUES
	(1, 'k1', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
	(2, 'k2', 10, 200, 3000000000, 2.22, 222.2222222222, '12:00:00', '2023-01-01', '2023-01-01 12:00:00', '2023-01-01 12:00:00', 'hello'),
	(3, 'k3', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);

# NULL TINYINT value
SELECT JSON_OBJECTAGG(str_key, col_tinyint) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_tinyint) FROM t_json_obj_null_duckdb;

# NULL INT value
SELECT JSON_OBJECTAGG(str_key, col_int) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_int) FROM t_json_obj_null_duckdb;

# NULL BIGINT value
SELECT JSON_OBJECTAGG(str_key, col_bigint) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_bigint) FROM t_json_obj_null_duckdb;

# NULL DOUBLE value
SELECT JSON_OBJECTAGG(str_key, col_double) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_double) FROM t_json_obj_null_duckdb;

# NULL DECIMAL value
SELECT JSON_OBJECTAGG(str_key, col_decimal) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_decimal) FROM t_json_obj_null_duckdb;

# NULL TIME value
SELECT JSON_OBJECTAGG(str_key, col_time) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_time) FROM t_json_obj_null_duckdb;

# NULL DATE value
SELECT JSON_OBJECTAGG(str_key, col_date) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_date) FROM t_json_obj_null_duckdb;

# NULL DATETIME value
SELECT JSON_OBJECTAGG(str_key, col_datetime) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_datetime) FROM t_json_obj_null_duckdb;

# NULL TIMESTAMP value
SELECT JSON_OBJECTAGG(str_key, col_timestamp) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_timestamp) FROM t_json_obj_null_duckdb;

# NULL VARCHAR value
SELECT JSON_OBJECTAGG(str_key, col_varchar) FROM t_json_obj_null_innodb;
SELECT JSON_OBJECTAGG(str_key, col_varchar) FROM t_json_obj_null_duckdb;

# ----- 8.5 Empty result set -----
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_innodb WHERE id = 999;
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_duckdb WHERE id = 999;

# ----- 8.6 Single row -----
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_innodb WHERE id = 1;
SELECT JSON_OBJECTAGG(col_varchar, col_int) FROM t_json_obj_duckdb WHERE id = 1;

# ----- 8.7 GROUP BY with JSON_OBJECTAGG -----
CREATE TABLE t_json_obj_grp_innodb (
	id INT PRIMARY KEY,
	grp INT,
	str_key VARCHAR(20),
	val INT
);

CREATE TABLE t_json_obj_grp_duckdb (
	id INT PRIMARY KEY,
	grp INT,
	str_key VARCHAR(20),
	val INT
) ENGINE=DuckDB;

INSERT INTO t_json_obj_grp_innodb VALUES
	(1, 1, 'a', 10),
	(2, 1, 'b', 20),
	(3, 2, 'c', 30),
	(4, 2, 'd', NULL),
	(5, 3, 'e', 50);

INSERT INTO t_json_obj_grp_duckdb VALUES
	(1, 1, 'a', 10),
	(2, 1, 'b', 20),
	(3, 2, 'c', 30),
	(4, 2, 'd', NULL),
	(5, 3, 'e', 50);

SELECT grp, JSON_OBJECTAGG(str_key, val) FROM t_json_obj_grp_innodb GROUP BY grp ORDER BY grp;
SELECT grp, JSON_OBJECTAGG(str_key, val) FROM t_json_obj_grp_duckdb GROUP BY grp ORDER BY grp;

# ----- 8.8 Duplicate keys -----
CREATE TABLE t_json_obj_dup_innodb (
	id INT PRIMARY KEY,
	str_key VARCHAR(20),
	val INT
);

CREATE TABLE t_json_obj_dup_duckdb (
	id INT PRIMARY KEY,
	str_key VARCHAR(20),
	val INT
) ENGINE=DuckDB;

INSERT INTO t_json_obj_dup_innodb VALUES (1, 'dup', 100), (2, 'dup', 200), (3, 'unique', 300);
INSERT INTO t_json_obj_dup_duckdb VALUES (1, 'dup', 100), (2, 'dup', 200), (3, 'unique', 300);

SELECT JSON_OBJECTAGG(str_key, val) FROM t_json_obj_dup_innodb;
SELECT JSON_OBJECTAGG(str_key, val) FROM t_json_obj_dup_duckdb;

# ----- 8.9 Large values -----
CREATE TABLE t_json_obj_large_innodb (
	id INT PRIMARY KEY,
	str_key VARCHAR(100),
	val VARCHAR(1000)
);

CREATE TABLE t_json_obj_large_duckdb (
	id INT PRIMARY KEY,
	str_key VARCHAR(100),
	val VARCHAR(1000)
) ENGINE=DuckDB;

INSERT INTO t_json_obj_large_innodb VALUES
	(1, 'long_key_1', REPEAT('x', 500)),
	(2, 'long_key_2', REPEAT('y', 500)),
	(3, REPEAT('z', 50), 'short_val');

INSERT INTO t_json_obj_large_duckdb VALUES
	(1, 'long_key_1', REPEAT('x', 500)),
	(2, 'long_key_2', REPEAT('y', 500)),
	(3, REPEAT('z', 50), 'short_val');

SELECT LENGTH(JSON_OBJECTAGG(str_key, val)) FROM t_json_obj_large_innodb;
SELECT LENGTH(JSON_OBJECTAGG(str_key, val)) FROM t_json_obj_large_duckdb;

# ----- 8.10 Special string values (escaping) -----
CREATE TABLE t_json_obj_special_innodb (
	id INT PRIMARY KEY,
	str_key VARCHAR(50),
	val VARCHAR(100)
);

CREATE TABLE t_json_obj_special_duckdb (
	id INT PRIMARY KEY,
	str_key VARCHAR(50),
	val VARCHAR(100)
) ENGINE=DuckDB;

INSERT INTO t_json_obj_special_innodb VALUES
	(1, 'quote_key', 'value with "quotes"'),
	(2, 'slash_key', 'value with \\backslash'),
	(3, 'newline_key', 'value with \nnewline'),
	(4, 'tab_key', 'value with \ttab'),
	(5, 'unicode_key', 'value_unicode_\u0041');

INSERT INTO t_json_obj_special_duckdb VALUES
	(1, 'quote_key', 'value with "quotes"'),
	(2, 'slash_key', 'value with \\backslash'),
	(3, 'newline_key', 'value with \nnewline'),
	(4, 'tab_key', 'value with \ttab'),
	(5, 'unicode_key', 'value_unicode_\u0041');

SELECT JSON_OBJECTAGG(str_key, val) FROM t_json_obj_special_innodb;
SELECT JSON_OBJECTAGG(str_key, val) FROM t_json_obj_special_duckdb;

# ----- 8.11 All NULL values (only NULL values) -----
SELECT JSON_OBJECTAGG(str_key, col_tinyint) FROM t_json_obj_null_innodb WHERE id IN (1, 3);
SELECT JSON_OBJECTAGG(str_key, col_tinyint) FROM t_json_obj_null_duckdb WHERE id IN (1, 3);

# ----- Cleanup JSON_OBJECTAGG test tables -----
DROP TABLE t_json_obj_innodb;
DROP TABLE t_json_obj_duckdb;
DROP TABLE t_json_obj_null_innodb;
DROP TABLE t_json_obj_null_duckdb;
DROP TABLE t_json_obj_grp_innodb;
DROP TABLE t_json_obj_grp_duckdb;
DROP TABLE t_json_obj_dup_innodb;
DROP TABLE t_json_obj_dup_duckdb;
DROP TABLE t_json_obj_large_innodb;
DROP TABLE t_json_obj_large_duckdb;
DROP TABLE t_json_obj_special_innodb;
DROP TABLE t_json_obj_special_duckdb;

--echo --------------------------
--echo 9. MIN()
--echo --------------------------

SELECT MIN(col1), MIN(col2), MIN(col3), MIN(col4),
       MIN(col5), MIN(col6), MIN(col7), MIN(col8),
       MIN(col9), MIN(col10), MIN(col11)
FROM t_innodb;

SELECT MIN(col1), MIN(col2), MIN(col3), MIN(col4),
       MIN(col5), MIN(col6), MIN(col7), MIN(col8),
       MIN(col9), MIN(col10), MIN(col11)
FROM t_duckdb;

--echo --------------------------
--echo 10. MAX()
--echo --------------------------

SELECT MAX(col1), MAX(col2), MAX(col3), MAX(col4),
       MAX(col5), MAX(col6), MAX(col7), MAX(col8),
       MAX(col9), LENGTH(MAX(col10)), LENGTH(MAX(col11))
FROM t_innodb;

SELECT MAX(col1), MAX(col2), MAX(col3), MAX(col4),
       MAX(col5), MAX(col6), MAX(col7), MAX(col8),
       MAX(col9), LENGTH(MAX(col10)), LENGTH(MAX(col11))
FROM t_duckdb;

--echo --------------------------
--echo 11. STD()
--echo --------------------------

SELECT STD(col1), STD(col2), STD(col3), STD(col4),
       STD(col5), STD(col6), STD(col7), STD(col8),
       STD(col9), STD(col10)
FROM t_innodb;

SELECT STD(col1), STD(col2), STD(col3), STD(col4),
       STD(col5), STD(col6), STD(col7), STD(col8),
       STD(col9), STD(col10)
FROM t_duckdb;

# AVG(Blob) is not supported yet.
--error ER_DUCKDB_CLIENT
SELECT STD(col11)
FROM t_duckdb WHERE id <= 3;

