# ===========================================================
# Test: bugfix_drop_generated_column
# Description:
#   ALTER TABLE ... DROP COLUMN vcol, DROP COLUMN col on a DuckDB table
#   used to fail when vcol is a generated column that depends on col,
#   because DuckDB received DROP COLUMN col before DROP COLUMN vcol
#   and rejected the drop since vcol still references col.
#
#   The fix sorts generated columns before physical columns in the
#   drop list so DuckDB drops them in the correct dependency order.
#
# Related: Aone#81379311
# ===========================================================

--echo #
--echo # 1) DROP generated column and its dependency together
--echo #

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  col1 INT,
  col2 INT,
  vcol1 INT GENERATED ALWAYS AS (col1 + col2) STORED
) ENGINE=DuckDB;

INSERT INTO t1 (id, col1, col2) VALUES (1, 10, 20), (2, 30, 40);
SELECT * FROM t1;

# Drop generated column and its dependency in one statement
ALTER TABLE t1 DROP COLUMN vcol1, DROP COLUMN col1;
SELECT * FROM t1;

INSERT INTO t1 (id, col2) VALUES (3, 50);
SELECT * FROM t1;

DROP TABLE t1;

--echo #
--echo # 2) Drop base column listed before generated column (main bug scenario)
--echo #

CREATE TABLE t2 (
  id INT PRIMARY KEY,
  a INT,
  b INT,
  gc INT GENERATED ALWAYS AS (a + b) STORED
) ENGINE=DuckDB;

INSERT INTO t2 (id, a, b) VALUES (1, 1, 2), (2, 3, 4);
SELECT * FROM t2;

# Base column 'a' is listed before generated column 'gc' in the DROP,
# and 'a' is defined before 'gc' in the table — this was the exact
# failing scenario before the fix.
ALTER TABLE t2 DROP COLUMN a, DROP COLUMN gc;
SELECT * FROM t2;

DROP TABLE t2;

--echo #
--echo # 3) Drop multiple generated columns and their shared dependency
--echo #

CREATE TABLE t3 (
  id INT PRIMARY KEY,
  x INT,
  y INT,
  gc1 INT GENERATED ALWAYS AS (x + y) STORED,
  gc2 INT GENERATED ALWAYS AS (x * y) STORED,
  gc3 VARCHAR(100) GENERATED ALWAYS AS (CONCAT(x, '_', y)) STORED
) ENGINE=DuckDB;

INSERT INTO t3 (id, x, y) VALUES (1, 5, 6), (2, 7, 8);
SELECT * FROM t3;

# Drop x and all generated columns that depend on it
ALTER TABLE t3 DROP COLUMN x, DROP COLUMN gc1,
               DROP COLUMN gc2, DROP COLUMN gc3;
SELECT * FROM t3;

DROP TABLE t3;

--echo #
--echo # 4) Drop only generated columns (no base column dropped)
--echo #

CREATE TABLE t4 (
  id INT PRIMARY KEY,
  a INT,
  b INT,
  gc1 INT GENERATED ALWAYS AS (a + b) STORED,
  gc2 INT GENERATED ALWAYS AS (a - b) STORED
) ENGINE=DuckDB;

INSERT INTO t4 (id, a, b) VALUES (1, 10, 3);
SELECT * FROM t4;

ALTER TABLE t4 DROP COLUMN gc1, DROP COLUMN gc2;
SELECT * FROM t4;

DROP TABLE t4;

--echo #
--echo # 5) Drop all generated and all base columns except PK
--echo #

CREATE TABLE t5 (
  id INT PRIMARY KEY,
  c1 INT,
  c2 INT,
  vc1 INT GENERATED ALWAYS AS (c1 + c2) STORED,
  vc2 INT GENERATED ALWAYS AS (c1 - c2) STORED
) ENGINE=DuckDB;

INSERT INTO t5 (id, c1, c2) VALUES (1, 100, 200);
SELECT * FROM t5;

ALTER TABLE t5 DROP COLUMN c1, DROP COLUMN c2,
               DROP COLUMN vc1, DROP COLUMN vc2;
SELECT * FROM t5;

INSERT INTO t5 (id) VALUES (2);
SELECT * FROM t5;

DROP TABLE t5;
