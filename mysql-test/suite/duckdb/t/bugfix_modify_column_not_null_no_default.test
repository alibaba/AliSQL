--echo #
--echo # 13) CHANGE INT → ENUM — verify index-to-name mapping
--echo #
# InnoDB maps INT 1→'a', 2→'b' by enum index. DuckDB after fix does same.

CREATE TABLE t_innodb (id INT PRIMARY KEY, c INT) ENGINE=InnoDB;
CREATE TABLE t_duckdb (id INT PRIMARY KEY, c INT) ENGINE=DuckDB;
INSERT INTO t_innodb VALUES (1, NULL),(2, 1),(3, 2),(4, 0);
INSERT INTO t_duckdb VALUES (1, NULL),(2, 1),(3, 2),(4, 0);

--disable_warnings
ALTER TABLE t_innodb CHANGE COLUMN c d ENUM('a','b','c') NOT NULL;
--enable_warnings
ALTER TABLE t_duckdb CHANGE COLUMN c d ENUM('a','b','c') NOT NULL;

--let $checksum_t_innodb = query_get_value(CHECKSUM TABLE t_innodb, Checksum, 1)
--let $checksum_t_duckdb = query_get_value(CHECKSUM TABLE t_duckdb, Checksum, 1)
--let $assert_cond = $checksum_t_innodb = $checksum_t_duckdb
--let $assert_text = INT to ENUM CHANGE parity
--source include/assert.inc

SELECT id, d, HEX(d) FROM t_innodb ORDER BY id;
SELECT id, d, HEX(d) FROM t_duckdb ORDER BY id;

DROP TABLE t_innodb, t_duckdb;

